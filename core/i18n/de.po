msgid "CamAlert"
msgstr "CamAlert"

#: ha:selector.mode.options.strip
msgid "Multi-camera window"
msgstr "Fenster mit mehreren Kameras"

#: ha:selector.move.options.up
msgid "Up"
msgstr "Hoch"

#: ha:selector.move.options.down
msgid "Down"
msgstr "Runter"

#: ha:selector.move.options.left
msgid "Left"
msgstr "Links"

#: ha:selector.move.options.right
msgid "Right"
msgstr "Rechts"

#: ha:selector.move.options.zoom_in
msgid "Zoom in"
msgstr "Hineinzoomen"

#: ha:selector.move.options.zoom_out
