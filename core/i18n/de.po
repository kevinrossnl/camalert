msgid "Shows the camera when Frigate detects something (via MQTT, without Home Assistant)."
msgstr "Zeigt die Kamera, wenn Frigate etwas erkennt (per MQTT, ohne Home Assistant)."

#: e2 kodi:30132
msgid "Frigate MQTT prefix"
msgstr "Frigate-MQTT-Präfix"

#: e2 kodi:30133
msgid "Usually 'frigate'."
msgstr "Meist 'frigate'."

#: e2 kodi:30259
msgid "Frigate objects"
msgstr "Frigate-Objekte"

#: e2
msgid "Comma separated, e.g. person,car. Empty = all objects."
msgstr "Durch Komma getrennt, z. B. person,car. Leer = alle Objekte."

#: e2 kodi:30136
msgid "Frigate camera names"
msgstr "Frigate-Kameranamen"

#: e2
msgid "Only if the names differ from go2rtc: frigate=go2rtc|other=other_stream"
msgstr "Nur wenn die Namen von go2rtc abweichen: frigate=go2rtc|other=other_stream"

#: e2 kodi:30260
msgid "Frigate priority"
msgstr "Frigate-Priorität"

