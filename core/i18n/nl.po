msgid "Frigate camera names"
msgstr "Frigate-cameranamen"

#: e2
msgid "Only if the names differ from go2rtc: frigate=go2rtc|other=other_stream"
msgstr "Alleen als de namen afwijken van go2rtc: frigate=go2rtc|other=other_stream"

#: e2 kodi:30260
msgid "Frigate priority"
msgstr "Frigate-prioriteit"

#: e2 kodi:30143
msgid "Foscam motion and sound alarms"
msgstr "Foscam-bewegings- en geluidsalarmen"

#: e2
msgid "Asks the Foscam cameras in %s for motion and sound alarms."
msgstr "Vraagt de Foscam-camera's in %s om bewegings- en geluidsalarmen."

#: e2 kodi:30261
msgid "Foscam priority"
msgstr "Foscam-prioriteit"

#: e2 kodi:30237
msgid "Frigate address (for clips)"
msgstr "Frigate-adres (voor clips)"

