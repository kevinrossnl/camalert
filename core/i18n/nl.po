msgstr "Cameraapparaten (camerabediening, Foscam)"

#: atv:devices_help
msgid "One camera per line: name|onvif|address:port|user|password or name|foscam|address:88|user|password. The name is the CamAlert camera name. Empty user and password = the default login below."
msgstr "Eén camera per regel: naam|onvif|adres:poort|gebruiker|wachtwoord of naam|foscam|adres:88|gebruiker|wachtwoord. De naam is de cameranaam in CamAlert. Gebruiker en wachtwoord leeg = de standaardlogin hieronder."

#: atv:devices_none
msgid "no valid line"
msgstr "geen geldige regel"

#: atv:devices_where
msgid "the camera devices"
msgstr "de cameraapparaten"

#: atv:cameras_title
msgid "Cameras without go2rtc"
msgstr "Camera's zonder go2rtc"

#: atv:cameras_list
msgid "Camera list"
msgstr "Cameralijst"

#: atv:cameras_help
msgid "One camera per line: name | rtsp-url | snapshot-url (optional), e.g. Front door | rtsp://user:password@192.168.1.20:554/stream1 | http://user:password@192.168.1.20/snapshot.jpg. Used when Cameras via is Directly from the cameras."
msgstr "Eén camera per regel: naam | rtsp-url | snapshot-url (optioneel), bijv. Front door | rtsp://user:password@192.168.1.20:554/stream1 | http://user:password@192.168.1.20/snapshot.jpg. Wordt gebruikt als Camera's via op Rechtstreeks van de camera's staat."

#: atv:cameras_none
msgid "No cameras"
msgstr "Geen camera's"

#: atv:cameras_where
msgid "the camera list below"
msgstr "de cameralijst hieronder"

#: atv:unifi_no_console
