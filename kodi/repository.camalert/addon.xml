<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.camalert" name="CamAlert repository" version="1.0.0" provider-name="CamAlert developers">
  <extension point="xbmc.addon.repository" name="CamAlert repository">
    <dir>
      <info compressed="false">@REPO_URL@/addons.xml</info>
      <checksum>@REPO_URL@/addons.xml.md5</checksum>
      <datadir zip="true">@REPO_URL@</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Updates for CamAlert</summary>
    <summary lang="nl_NL">Updates voor CamAlert</summary>
    <description lang="en_GB">Install this once; Kodi then installs and updates CamAlert automatically.</description>
    <description lang="nl_NL">Eén keer installeren; daarna installeert en werkt Kodi CamAlert zelf bij.</description>
    <platform>all</platform>
    <license>GPL-2.0-only</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
