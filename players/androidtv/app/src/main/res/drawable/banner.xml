<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback launcher banner (320x180), drawn: no bitmap, no metadata. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2A38" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/icon" android:gravity="center" android:width="120dp" android:height="120dp" />
</layer-list>
