<?xml version="1.0" encoding="utf-8"?>
<!-- go2rtc, the MQTT broker and Home Assistant are plain HTTP in most home networks (#64). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
