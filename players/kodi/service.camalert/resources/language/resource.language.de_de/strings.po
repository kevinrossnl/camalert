msgid "go2rtc reachable (%d cameras, %d ms)"
msgstr "go2rtc erreichbar (%d Kameras, %d ms)"

msgctxt "#30211"
msgid "go2rtc not reachable: %s"
msgstr "go2rtc nicht erreichbar: %s"

msgctxt "#30212"
