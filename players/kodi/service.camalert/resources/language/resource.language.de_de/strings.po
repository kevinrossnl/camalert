msgstr "%s: keine Foto-Adresse (nur live)"

msgctxt "#30214"
msgid "%s: snapshot %d ms"
msgstr "%s: Foto %d ms"

msgctxt "#30215"
msgid "%s: snapshot failed (%s)"
msgstr "%s: Foto fehlgeschlagen (%s)"

msgctxt "#30216"
msgid "API listening on port %d"
msgstr "API lauscht auf Port %d"

msgctxt "#30217"
