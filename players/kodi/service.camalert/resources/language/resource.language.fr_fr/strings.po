msgctxt "#30000"
msgid "General"
msgstr "Général"

msgctxt "#30001"
msgid "Display"
msgstr "Affichage"

msgctxt "#30002"
msgid "Rules"
msgstr "Règles"

msgctxt "#30003"
msgid "MQTT / Home Assistant"
msgstr "MQTT / Home Assistant"

msgctxt "#30004"
msgid "Triggers"
msgstr "Déclencheurs"

msgctxt "#30005"
msgid "Camera control"
msgstr "Contrôle caméra"

msgctxt "#30006"
msgid "API"
msgstr "API"

msgctxt "#30007"
msgid "Log and diagnostics"
msgstr "Journal et diagnostic"

msgctxt "#30010"
msgid "Enable CamAlert"
msgstr "Activer CamAlert"

msgctxt "#30011"
msgid "Turn the HTTP API and the camera display on or off."
msgstr "Active ou désactive l'API HTTP et l'affichage des caméras."

msgctxt "#30012"
msgid "Cameras via"
msgstr "Caméras via"

msgctxt "#30013"
msgid "go2rtc is recommended. Without go2rtc, list your cameras in cameras.conf."
msgstr "go2rtc est recommandé. Sans go2rtc, listez les caméras dans cameras.conf."

msgctxt "#30014"
msgid "go2rtc server"
msgstr "Serveur go2rtc"

msgctxt "#30015"
msgid "Directly from the cameras"
msgstr "Directement depuis les caméras"

msgctxt "#30016"
msgid "go2rtc address"
msgstr "Adresse go2rtc"

msgctxt "#30017"
msgid "Address of your go2rtc server, e.g. http://192.168.1.10:1984"
msgstr "Adresse de votre serveur go2rtc, p. ex. http://192.168.1.10:1984"

msgctxt "#30018"
msgid "go2rtc RTSP port"
msgstr "Port RTSP go2rtc"

msgctxt "#30019"
msgid "Usually 8554. Only used with the RTSP live format."
msgstr "Généralement 8554. Utilisé seulement avec le format RTSP."

msgctxt "#30020"
msgid "Check certificates"
msgstr "Vérifier les certificats"

msgctxt "#30021"
msgid "Turn off for a self-signed certificate (only in your own network)."
msgstr "Désactivez pour un certificat auto-signé (uniquement sur votre réseau)."

msgctxt "#30022"
msgid "Camera file (direct mode)"
msgstr "Fichier caméras (mode direct)"

msgctxt "#30023"
msgid "Empty = cameras.conf in the add-on data folder. One camera per line: name | rtsp-url | snapshot-url"
msgstr "Vide = cameras.conf dans le dossier de données. Une caméra par ligne : nom | url-rtsp | url-instantané"

msgctxt "#30024"
msgid "Default camera"
msgstr "Caméra par défaut"

msgctxt "#30025"
msgid "Camera name, e.g. front_door. Use 'Choose camera' to pick it from the list."
msgstr "Nom de la caméra, p. ex. porte. Utilisez « Choisir la caméra »."

msgctxt "#30026"
msgid "Choose camera"
msgstr "Choisir la caméra"

msgctxt "#30027"
msgid "Camera names"
msgstr "Noms des caméras"

msgctxt "#30028"
msgid "Optional: name=Title|name2=Title 2"
msgstr "Optionnel : nom=Titre|nom2=Titre 2"

msgctxt "#30029"
msgid "Mosaic cameras"
msgstr "Caméras de la mosaïque"

msgctxt "#30030"
msgid "Comma separated, up to 9. Empty = all."
msgstr "Séparées par des virgules, 9 max. Vide = toutes."

msgctxt "#30040"
msgid "Display mode"
msgstr "Mode d'affichage"

msgctxt "#30041"
msgid "Photo window keeps playing what you watch; live shows the camera stream full screen."
msgstr "La fenêtre photo laisse tourner le programme ; le direct affiche la caméra en plein écran."

msgctxt "#30042"
msgid "Photo window"
msgstr "Fenêtre photo"

msgctxt "#30043"
msgid "Live view"
msgstr "Direct"

msgctxt "#30044"
msgid "Notification"
msgstr "Notification"

msgctxt "#30045"
msgid "Duration (seconds)"
msgstr "Durée (secondes)"

msgctxt "#30046"
msgid "How long the camera stays on screen."
msgstr "Durée d'affichage de la caméra."

msgctxt "#30047"
msgid "Window position"
msgstr "Position de la fenêtre"

msgctxt "#30048"
msgid "Top right"
msgstr "En haut à droite"

msgctxt "#30049"
msgid "Top left"
msgstr "En haut à gauche"

msgctxt "#30050"
msgid "Bottom right"
msgstr "En bas à droite"

msgctxt "#30051"
msgid "Bottom left"
msgstr "En bas à gauche"

msgctxt "#30052"
msgid "Window size"
msgstr "Taille de la fenêtre"

msgctxt "#30053"
msgid "Small"
msgstr "Petite"

msgctxt "#30054"
msgid "Medium"
msgstr "Moyenne"

msgctxt "#30055"
msgid "Large"
msgstr "Grande"

msgctxt "#30056"
msgid "Multi-camera window layout"
msgstr "Disposition de la fenêtre multi-caméras"

msgctxt "#30057"
msgid "Layout when a request names 2 to 4 cameras (photo window)."
msgstr "Disposition quand une demande cite 2 à 4 caméras (fenêtre photo)."

msgctxt "#30058"
msgid "Automatic"
msgstr "Automatique"

msgctxt "#30059"
msgid "Below each other"
msgstr "Les unes sous les autres"

msgctxt "#30060"
msgid "Next to each other"
msgstr "Côte à côte"

msgctxt "#30061"
msgid "Grid (2x2)"
msgstr "Grille (2x2)"

msgctxt "#30062"
msgid "Turn or mirror image"
msgstr "Tourner ou inverser l'image"

msgctxt "#30063"
msgid "e.g. front_door=rot180|garden=mirror (rot180, mirror, flip)"
msgstr "p. ex. porte=rot180|jardin=mirror (rot180, mirror, flip)"

msgctxt "#30064"
msgid "Refresh interval"
msgstr "Intervalle d'actualisation"

msgctxt "#30065"
msgid "Seconds between pictures, e.g. front_door=0.5|garden=5. Default: as fast as possible."
msgstr "Secondes entre les images, p. ex. porte=0.5|jardin=5. Par défaut : au plus vite."

msgctxt "#30066"
msgid "Remote control in photo window"
msgstr "Télécommande dans la fenêtre photo"

msgctxt "#30067"
msgid "OK = live, LEFT/RIGHT = other camera, MENU = PTZ, BACK = close. Any other key closes it too."
msgstr "OK = direct, GAUCHE/DROITE = autre caméra, MENU = PTZ, RETOUR = fermer. Toute autre touche ferme aussi."

msgctxt "#30068"
msgid "Pause what is playing meanwhile"
msgstr "Mettre la lecture en pause"

msgctxt "#30069"
msgid "Pauses a video or live TV while the camera is shown and continues afterwards."
msgstr "Met en pause la vidéo ou la TV pendant l'affichage, puis reprend."

msgctxt "#30070"
msgid "Return to what was playing"
msgstr "Revenir à la lecture précédente"

msgctxt "#30071"
msgid "After live view, continue the video at the same position or the same TV channel."
msgstr "Après le direct, reprendre la vidéo au même endroit ou la même chaîne."

msgctxt "#30072"
msgid "Volume during live view (%)"
msgstr "Volume pendant le direct (%)"

msgctxt "#30073"
msgid "Percentage of the current volume while the camera is shown. 100 = unchanged."
msgstr "Pourcentage du volume actuel pendant l'affichage de la caméra. 100 = inchangé."

msgctxt "#30074"
msgid "Live stream format"
msgstr "Format du direct"

msgctxt "#30075"
msgid "MP4 over HTTP works with every go2rtc set-up; RTSP needs go2rtc's RTSP port; HLS is the most robust but lags a few seconds."
msgstr "Le MP4 via HTTP fonctionne avec toute installation go2rtc ; le RTSP nécessite le port RTSP de go2rtc ; le HLS est le plus robuste mais a quelques secondes de retard."

msgctxt "#30076"
msgid "MP4 (HTTP)"
msgstr "MP4 (HTTP)"

msgctxt "#30077"
msgid "RTSP"
msgstr "RTSP"

msgctxt "#30078"
msgid "Tour: seconds per camera"
msgstr "Ronde : secondes par caméra"

msgctxt "#30079"
msgid "How long each camera is shown in the tour."
msgstr "Durée de chaque caméra pendant la ronde."

msgctxt "#30080"
msgid "HLS (HTTP, a few seconds delay)"
msgstr "HLS (HTTP, quelques secondes de retard)"

msgctxt "#30090"
msgid "Only between certain times"
msgstr "Seulement à certaines heures"

msgctxt "#30091"
msgid "Ignore normal requests outside the chosen times. High and alarm always come through."
msgstr "Ignorer les demandes normales en dehors des heures choisies. Haute et alarme passent toujours."

msgctxt "#30092"
msgid "From"
msgstr "De"

msgctxt "#30093"
msgid "Until"
msgstr "Jusqu'à"

msgctxt "#30094"
msgid "May pass midnight, e.g. 07:00 to 23:00."
msgstr "Peut passer minuit, p. ex. 07:00 à 23:00."

msgctxt "#30095"
msgid "Not while playing"
msgstr "Pas pendant la lecture"

msgctxt "#30096"
msgid "Normal-priority requests are ignored while you watch this. High and alarm always pass."
msgstr "Les demandes normales sont ignorées pendant ce visionnage. Haute et alarme passent toujours."

msgctxt "#30097"
msgid "Always show"
msgstr "Toujours afficher"

msgctxt "#30098"
msgid "Not during movies and recordings"
msgstr "Pas pendant les films et enregistrements"

msgctxt "#30099"
msgid "Not during anything (also live TV)"
msgstr "Jamais pendant une lecture (TV comprise)"

msgctxt "#30100"
msgid "Wake up on alarm"
msgstr "Réveiller en cas d'alarme"

msgctxt "#30101"
msgid "Requests with priority 'alarm' switch the TV on via HDMI-CEC."
msgstr "Les demandes « alarm » allument la TV via HDMI-CEC."

msgctxt "#30102"
msgid "Do not disturb"
msgstr "Ne pas déranger"

msgctxt "#30103"
msgid "Ignores requests with normal priority (with 'Do not disturb blocks' also high). Alarm always comes through. Also via the API, MQTT and Home Assistant."
msgstr "Ignore les demandes de priorité normale (avec « Ne pas déranger bloque », aussi la priorité haute). L'alarme passe toujours. Aussi via l'API, MQTT et Home Assistant."

msgctxt "#30104"
msgid "Do not disturb blocks"
msgstr "Ne pas déranger bloque"

msgctxt "#30105"
msgid "Which priorities are held back while do not disturb is on."
msgstr "Priorités bloquées en mode ne pas déranger."

msgctxt "#30106"
msgid "Normal priority"
msgstr "Priorité normale"

msgctxt "#30107"
msgid "Normal and high priority"
msgstr "Priorités normale et haute"

msgctxt "#30110"
msgid "MQTT (Home Assistant without YAML)"
msgstr "MQTT (Home Assistant sans YAML)"

msgctxt "#30111"
msgid "Connects to your MQTT broker; with discovery this Kodi appears in Home Assistant automatically."
msgstr "Se connecte au broker MQTT ; avec la découverte, ce Kodi apparaît dans Home Assistant."

msgctxt "#30112"
msgid "MQTT broker address"
msgstr "Adresse du broker MQTT"

msgctxt "#30113"
msgid "IP address or name of the MQTT broker, e.g. 192.168.1.10"
msgstr "Adresse IP ou nom du broker MQTT, p. ex. 192.168.1.10"

msgctxt "#30114"
msgid "MQTT port"
msgstr "Port MQTT"

msgctxt "#30115"
msgid "Usually 1883."
msgstr "Généralement 1883."

msgctxt "#30116"
msgid "MQTT user"
msgstr "Utilisateur MQTT"

msgctxt "#30117"
msgid "MQTT password"
msgstr "Mot de passe MQTT"

msgctxt "#30118"
msgid "Home Assistant discovery"
msgstr "Découverte Home Assistant"

msgctxt "#30119"
msgid "Creates a device with a button per camera in Home Assistant."
msgstr "Crée dans Home Assistant un appareil avec un bouton par caméra."

msgctxt "#30120"
msgid "Name in Home Assistant"
msgstr "Nom dans Home Assistant"

msgctxt "#30121"
msgid "Empty = CamAlert + the name of this Kodi."
msgstr "Vide = CamAlert + le nom de ce Kodi."

msgctxt "#30130"
msgid "Frigate events"
msgstr "Événements Frigate"

msgctxt "#30131"
msgid "Shows the camera when Frigate detects something (via the MQTT broker)."
msgstr "Affiche la caméra quand Frigate détecte quelque chose (via MQTT)."

msgctxt "#30132"
msgid "Frigate MQTT prefix"
msgstr "Préfixe MQTT de Frigate"

msgctxt "#30133"
msgid "Usually 'frigate'."
msgstr "Généralement 'frigate'."

msgctxt "#30134"
msgid "Objects"
msgstr "Objets"

msgctxt "#30135"
msgid "e.g. person,car. Empty = all."
msgstr "p. ex. person,car. Vide = tous."

msgctxt "#30136"
msgid "Frigate camera names"
msgstr "Noms des caméras Frigate"

msgctxt "#30137"
msgid "Only if they differ: frigate_name=camera|..."
msgstr "Seulement s'ils diffèrent : nom_frigate=caméra|..."

msgctxt "#30139"
msgid "Priority"
msgstr "Priorité"

msgctxt "#30140"
msgid "Normal"
msgstr "Normale"

msgctxt "#30141"
msgid "High"
msgstr "Haute"

msgctxt "#30142"
msgid "Alarm"
msgstr "Alarme"

msgctxt "#30143"
msgid "Foscam motion and sound alarms"
msgstr "Alarmes de mouvement et de son Foscam"

msgctxt "#30144"
msgid "Asks the Foscam cameras in devices.conf for motion and sound alarms."
msgstr "Interroge les caméras Foscam de devices.conf sur les alarmes."

msgctxt "#30145"
msgid "Check every (seconds)"
msgstr "Vérifier toutes les (secondes)"

msgctxt "#30150"
msgid "Cameras with PTZ or Foscam alarms"
msgstr "Caméras avec PTZ ou alarme Foscam"

msgctxt "#30151"
msgid "Listed in devices.conf in the add-on data folder, one per line: name|onvif|address:80|user|password (or foscam, port 88)"
msgstr "Listées dans devices.conf du dossier de données, une par ligne : nom|onvif|adresse:80|utilisateur|motdepasse (ou foscam, port 88)"

msgctxt "#30152"
msgid "Camera user (default)"
msgstr "Utilisateur caméra (défaut)"

msgctxt "#30153"
msgid "Used when devices.conf has no user or password for a camera."
msgstr "Utilisé si devices.conf n'indique ni utilisateur ni mot de passe."

msgctxt "#30154"
msgid "Camera password (default)"
msgstr "Mot de passe caméra (défaut)"

msgctxt "#30155"
msgid "Create devices.conf (example)"
msgstr "Créer devices.conf (exemple)"

msgctxt "#30160"
msgid "HTTP port"
msgstr "Port HTTP"

msgctxt "#30161"
msgid "Port of the CamAlert API on this Kodi (default 8099)."
msgstr "Port de l'API CamAlert sur ce Kodi (8099 par défaut)."

msgctxt "#30162"
msgid "Allowed callers"
msgstr "Appelants autorisés"

msgctxt "#30163"
msgid "'Local network only' is recommended."
msgstr "« Réseau local uniquement » est recommandé."

msgctxt "#30164"
msgid "Local network only"
msgstr "Réseau local uniquement"

msgctxt "#30165"
msgid "Any address"
msgstr "Toute adresse"

msgctxt "#30166"
msgid "Access token (optional)"
msgstr "Jeton d'accès (facultatif)"

msgctxt "#30167"
msgid "If set, callers must send it in the X-CamAlert-Token header; ?token=... in the address still works but is deprecated."
msgstr "Si défini, les appelants doivent l'envoyer dans l'en-tête X-CamAlert-Token ; ?token=... dans l'adresse fonctionne encore mais est obsolète."

msgctxt "#30168"
msgid "Use HTTPS for the API"
msgstr "Utiliser HTTPS pour l'API"

msgctxt "#30169"
msgid "Uses a self-signed certificate; callers must turn off certificate checking."
msgstr "Utilise un certificat auto-signé ; les appelants doivent désactiver la vérification."

msgctxt "#30170"
msgid "Test: show the default camera"
msgstr "Test : afficher la caméra par défaut"

msgctxt "#30171"
msgid "Show mosaic"
msgstr "Afficher la mosaïque"

msgctxt "#30172"
msgid "Start tour"
msgstr "Lancer la ronde"

msgctxt "#30180"
msgid "Camera: %s"
msgstr "Caméra : %s"

msgctxt "#30181"
msgid "Could not reach the camera source:\n%s"
msgstr "Source des caméras injoignable :\n%s"

msgctxt "#30182"
msgid "No cameras found."
msgstr "Aucune caméra trouvée."

msgctxt "#30184"
msgid "Choose a default camera first."
msgstr "Choisissez d'abord une caméra par défaut."

msgctxt "#30185"
msgid "devices.conf is in:\n%s"
msgstr "devices.conf se trouve dans :\n%s"

msgctxt "#30190"
msgid "paused"
msgstr "en pause"

msgctxt "#30191"
msgid "tour"
msgstr "ronde"

msgctxt "#30192"
msgid "Cameras"
msgstr "Caméras"

msgctxt "#30196"
msgid "No camera control set up for this camera (devices.conf)."
msgstr "Pas de contrôle configuré pour cette caméra (devices.conf)."

msgctxt "#30200"
msgid "Checking..."
msgstr "Vérification..."

msgctxt "#30201"
msgid "Diagnostics"
msgstr "Diagnostic"

msgctxt "#30202"
msgid "The CamAlert service is not running."
msgstr "Le service CamAlert ne tourne pas."

msgctxt "#30203"
msgid "No events yet."
msgstr "Aucun événement pour l'instant."

msgctxt "#30204"
msgid "Event list"
msgstr "Liste des événements"

msgctxt "#30205"
msgid "Show camera"
msgstr "Afficher une caméra"

msgctxt "#30206"
msgid "Play Frigate clip"
msgstr "Lire le clip Frigate"

msgctxt "#30210"
msgid "go2rtc reachable (%d cameras, %d ms)"
msgstr "go2rtc joignable (%d caméras, %d ms)"

msgctxt "#30211"
msgid "go2rtc not reachable: %s"
msgstr "go2rtc injoignable : %s"

msgctxt "#30212"
msgid "No valid go2rtc address"
msgstr "Aucune adresse go2rtc valide"

msgctxt "#30213"
msgid "%s: no snapshot address (live only)"
msgstr "%s : pas d'adresse photo (direct seulement)"

msgctxt "#30214"
msgid "%s: snapshot %d ms"
msgstr "%s : photo %d ms"

msgctxt "#30215"
msgid "%s: snapshot failed (%s)"
msgstr "%s : échec de la photo (%s)"

msgctxt "#30216"
msgid "API listening on port %d"
msgstr "API à l'écoute sur le port %d"

msgctxt "#30217"
msgid "API not listening on port %d"
msgstr "API pas à l'écoute sur le port %d"

msgctxt "#30218"
msgid "MQTT connected"
msgstr "MQTT connecté"

msgctxt "#30219"
msgid "MQTT not connected"
msgstr "MQTT non connecté"

msgctxt "#30220"
msgid "Last API call %s from %s (%s)"
msgstr "Dernier appel API %s depuis %s (%s)"

msgctxt "#30221"
msgid "No API call since the last start"
msgstr "Aucun appel API depuis le dernier démarrage"

msgctxt "#30222"
msgid "Devices file: %s"
msgstr "Fichier des appareils : %s"

msgctxt "#30223"
msgid "Do not disturb is on"
msgstr "Ne pas déranger est activé"

msgctxt "#30224"
msgid "Log: %s"
msgstr "Journal : %s"

msgctxt "#30230"
msgid "Title size"
msgstr "Taille du titre"

msgctxt "#30231"
msgid "Normal"
msgstr "Normale"

msgctxt "#30232"
msgid "Doorbell chime"
msgstr "Son de sonnette"

msgctxt "#30233"
msgid "Plays a chime when a camera appears (follows Kodi's volume)."
msgstr "Joue un carillon quand une caméra apparaît (suit le volume de Kodi)."

msgctxt "#30234"
msgid "Off"
msgstr "Désactivé"

msgctxt "#30235"
msgid "Doorbell and alarm"
msgstr "Sonnette et alarme"

msgctxt "#30236"
msgid "Every request"
msgstr "Chaque demande"

msgctxt "#30237"
msgid "Frigate address (for clips)"
msgstr "Adresse de Frigate (pour les clips)"

msgctxt "#30238"
msgid "e.g. http://192.168.1.10:5000 - lets you replay Frigate clips from the event list."
msgstr "p. ex. http://192.168.1.10:5000 - permet de revoir les clips Frigate depuis la liste des événements."

msgctxt "#30239"
msgid "Camera control (PTZ) key"
msgstr "Touche de contrôle de la caméra (PTZ)"

msgctxt "#30240"
msgid "On cameras with PTZ this key toggles camera control (MENU works too)."
msgstr "Sur les caméras PTZ cette touche active le contrôle (MENU aussi)."

msgctxt "#30241"
msgid "RED"
msgstr "ROUGE"

msgctxt "#30242"
msgid "GREEN"
msgstr "VERT"

msgctxt "#30243"
msgid "YELLOW"
msgstr "JAUNE"

msgctxt "#30244"
msgid "BLUE"
msgstr "BLEU"

msgctxt "#30245"
msgid "Colour keys to Home Assistant"
msgstr "Touches de couleur vers Home Assistant"

msgctxt "#30246"
msgid "While a camera is shown the colour keys trigger a Home Assistant event (e.g. open the door)."
msgstr "Pendant l'affichage, les touches de couleur déclenchent un événement Home Assistant (p. ex. ouvrir la porte)."

msgctxt "#30247"
msgid "Log level"
msgstr "Niveau du journal"

msgctxt "#30248"
msgid "camalert.log in the add-on data folder (2 x 1 MB), besides kodi.log. Passwords are never logged."
msgstr "camalert.log dans le dossier de données (2 x 1 Mo), en plus de kodi.log. Les mots de passe ne sont jamais journalisés."

msgctxt "#30249"
msgid "Errors only"
msgstr "Erreurs seulement"

msgctxt "#30250"
msgid "Verbose"
msgstr "Détaillé"

msgctxt "#30251"
msgid "Remote syslog (host:port)"
msgstr "Syslog distant (hôte:port)"

msgctxt "#30252"
msgid "Optional, e.g. 192.168.1.10:514 (UDP). Empty = off."
msgstr "Facultatif, p. ex. 192.168.1.10:514 (UDP). Vide = désactivé."

msgctxt "#30253"
msgid "Home Assistant webhook"
msgstr "Webhook Home Assistant"

msgctxt "#30254"
msgid "%s - camera not reachable"
msgstr "%s - caméra injoignable"

msgctxt "#30255"
msgid "Cooldown per camera"
msgstr "Délai par caméra"

msgctxt "#30256"
msgid "Seconds per camera, e.g. *=30|garden=120 (* = all). An open window is still extended; alarm always passes."
msgstr "Secondes par caméra, p. ex. *=30|jardin=120 (* = toutes). Une fenêtre ouverte est prolongée ; l'alarme passe toujours."

msgctxt "#30257"
msgid "Live view substreams"
msgstr "Sous-flux pour le direct"

msgctxt "#30258"
msgid "For a camera this Kodi cannot play smoothly (H.265 / 4K): front_door=front_door_sub|... (go2rtc stream names)."
msgstr "Pour une caméra que ce Kodi ne lit pas bien (H.265 / 4K) : porte=porte_sub|... (noms de flux go2rtc)."

msgctxt "#30259"
msgid "Frigate objects"
msgstr "Objets Frigate"

msgctxt "#30260"
msgid "Frigate priority"
msgstr "Priorité Frigate"

msgctxt "#30261"
msgid "Foscam priority"
msgstr "Priorité Foscam"

msgctxt "#30262"
msgid "UniFi Protect events"
msgstr "Événements UniFi Protect"

msgctxt "#30263"
msgid "Asks the UniFi Protect consoles in devices.conf for events (doorbell, person, vehicle, ...)."
msgstr "Interroge les consoles UniFi Protect de devices.conf sur les événements (sonnette, personne, véhicule, ...)."

msgctxt "#30264"
msgid "UniFi Protect event types"
msgstr "Types d'événements UniFi Protect"

msgctxt "#30265"
msgid "Comma separated: ring, person, vehicle, animal, package, motion."
msgstr "Séparés par des virgules : ring, person, vehicle, animal, package, motion."

msgctxt "#30266"
msgid "UniFi Protect camera names"
msgstr "Noms des caméras UniFi Protect"

msgctxt "#30267"
msgid "Only if the names differ from go2rtc: protect=go2rtc|other=other_stream"
msgstr "Seulement si les noms diffèrent de go2rtc : protect=go2rtc|other=other_stream"

msgctxt "#30268"
msgid "UniFi Protect priority"
msgstr "Priorité UniFi Protect"

msgctxt "#30269"
msgid "A doorbell ring always gets at least the priority High."
msgstr "Un coup de sonnette reçoit toujours au moins la priorité Haute."

msgctxt "#30270"
msgid "Log only"
msgstr "Journal uniquement"

msgctxt "#30271"
msgid "Per event type"
msgstr "Par type d'événement"

msgctxt "#30272"
msgid "Optional: type=priority/mode/camera, e.g. ring=alarm/live|motion=normal/log"
msgstr "Facultatif : type=priority/mode/camera, p. ex. ring=alarm/live|motion=normal/log"

msgctxt "#30273"
msgid "Per camera"
msgstr "Par caméra"

msgctxt "#30274"
msgid "Optional, wins over the event type: camera=priority/mode/seconds, e.g. front_door=high/photo/30|driveway=normal/log"
msgstr "Facultatif, prioritaire sur le type d'événement : camera=priority/mode/seconds, p. ex. front_door=high/photo/30|driveway=normal/log"

msgctxt "#30275"
msgid "Change camera password (default)"
msgstr "Modifier le mot de passe caméra (défaut)"

msgctxt "#30276"
msgid "Shows whether a default camera password is stored and lets you change or remove it. It is kept in devices.conf, not in the Kodi settings."
msgstr "Indique si un mot de passe caméra par défaut est enregistré et vous permet de le modifier ou de le supprimer. Il est conservé dans devices.conf, pas dans les paramètres de Kodi."

