msgctxt "#30000"
msgid "General"
msgstr "Generale"

msgctxt "#30001"
msgid "Display"
msgstr "Visualizzazione"

msgctxt "#30002"
msgid "Rules"
msgstr "Regole"

msgctxt "#30003"
msgid "MQTT / Home Assistant"
msgstr "MQTT / Home Assistant"

msgctxt "#30004"
msgid "Triggers"
msgstr "Attivatori"

msgctxt "#30005"
msgid "Camera control"
msgstr "Controllo telecamera"

msgctxt "#30006"
msgid "API"
msgstr "API"

msgctxt "#30007"
msgid "Log and diagnostics"
msgstr "Log e diagnostica"

msgctxt "#30010"
msgid "Enable CamAlert"
msgstr "Attiva CamAlert"

msgctxt "#30011"
msgid "Turn the HTTP API and the camera display on or off."
msgstr "Attiva o disattiva l'API HTTP e la visualizzazione delle telecamere."

msgctxt "#30012"
msgid "Cameras via"
msgstr "Telecamere tramite"

msgctxt "#30013"
msgid "go2rtc is recommended. Without go2rtc, list your cameras in cameras.conf."
msgstr "go2rtc è consigliato. Senza go2rtc elenca le telecamere in cameras.conf."

msgctxt "#30014"
msgid "go2rtc server"
msgstr "Server go2rtc"

msgctxt "#30015"
msgid "Directly from the cameras"
msgstr "Direttamente dalle telecamere"

msgctxt "#30016"
msgid "go2rtc address"
msgstr "Indirizzo go2rtc"

msgctxt "#30017"
msgid "Address of your go2rtc server, e.g. http://192.168.1.10:1984"
msgstr "Indirizzo del server go2rtc, ad es. http://192.168.1.10:1984"

msgctxt "#30018"
msgid "go2rtc RTSP port"
msgstr "Porta RTSP go2rtc"

msgctxt "#30019"
msgid "Usually 8554. Only used with the RTSP live format."
msgstr "Di solito 8554. Usato solo con il formato RTSP."

msgctxt "#30020"
msgid "Check certificates"
msgstr "Verifica certificati"

msgctxt "#30021"
msgid "Turn off for a self-signed certificate (only in your own network)."
msgstr "Disattivare per un certificato autofirmato (solo nella propria rete)."

msgctxt "#30022"
msgid "Camera file (direct mode)"
msgstr "File telecamere (diretto)"

msgctxt "#30023"
msgid "Empty = cameras.conf in the add-on data folder. One camera per line: name | rtsp-url | snapshot-url"
msgstr "Vuoto = cameras.conf nella cartella dati. Una telecamera per riga: nome | url-rtsp | url-istantanea"

msgctxt "#30024"
msgid "Default camera"
msgstr "Telecamera predefinita"

msgctxt "#30025"
msgid "Camera name, e.g. front_door. Use 'Choose camera' to pick it from the list."
msgstr "Nome della telecamera, ad es. ingresso. Usare 'Scegliere la telecamera'."

msgctxt "#30026"
msgid "Choose camera"
msgstr "Scegliere la telecamera"

msgctxt "#30027"
msgid "Camera names"
msgstr "Nomi delle telecamere"

msgctxt "#30028"
msgid "Optional: name=Title|name2=Title 2"
msgstr "Facoltativo: nome=Titolo|nome2=Titolo 2"

msgctxt "#30029"
msgid "Mosaic cameras"
msgstr "Telecamere del mosaico"

msgctxt "#30030"
msgid "Comma separated, up to 9. Empty = all."
msgstr "Separate da virgole, fino a 9. Vuoto = tutte."

msgctxt "#30040"
msgid "Display mode"
msgstr "Modalità di visualizzazione"

msgctxt "#30041"
msgid "Photo window keeps playing what you watch; live shows the camera stream full screen."
msgstr "La finestra foto lascia in riproduzione il programma; live mostra la telecamera a schermo intero."

msgctxt "#30042"
msgid "Photo window"
msgstr "Finestra foto"

msgctxt "#30043"
msgid "Live view"
msgstr "Visione live"

msgctxt "#30044"
msgid "Notification"
msgstr "Notifica"

msgctxt "#30045"
msgid "Duration (seconds)"
msgstr "Durata (secondi)"

msgctxt "#30046"
msgid "How long the camera stays on screen."
msgstr "Per quanto tempo resta visibile la telecamera."

msgctxt "#30047"
msgid "Window position"
msgstr "Posizione finestra"

msgctxt "#30048"
msgid "Top right"
msgstr "In alto a destra"

msgctxt "#30049"
msgid "Top left"
msgstr "In alto a sinistra"

msgctxt "#30050"
msgid "Bottom right"
msgstr "In basso a destra"

msgctxt "#30051"
msgid "Bottom left"
msgstr "In basso a sinistra"

msgctxt "#30052"
msgid "Window size"
msgstr "Dimensione finestra"

msgctxt "#30053"
msgid "Small"
msgstr "Piccola"

msgctxt "#30054"
msgid "Medium"
msgstr "Media"

msgctxt "#30055"
msgid "Large"
msgstr "Grande"

msgctxt "#30056"
msgid "Multi-camera window layout"
msgstr "Disposizione della finestra con più telecamere"

msgctxt "#30057"
msgid "Layout when a request names 2 to 4 cameras (photo window)."
msgstr "Disposizione quando una richiesta indica da 2 a 4 telecamere (finestra foto)."

msgctxt "#30058"
msgid "Automatic"
msgstr "Automatico"

msgctxt "#30059"
msgid "Below each other"
msgstr "Una sotto l'altra"

msgctxt "#30060"
msgid "Next to each other"
msgstr "Una accanto all'altra"

msgctxt "#30061"
msgid "Grid (2x2)"
msgstr "Griglia (2x2)"

msgctxt "#30062"
msgid "Turn or mirror image"
msgstr "Ruota o specchia l'immagine"

msgctxt "#30063"
msgid "e.g. front_door=rot180|garden=mirror (rot180, mirror, flip)"
msgstr "ad es. ingresso=rot180|giardino=mirror (rot180, mirror, flip)"

msgctxt "#30064"
msgid "Refresh interval"
msgstr "Intervallo di aggiornamento"

msgctxt "#30065"
msgid "Seconds between pictures, e.g. front_door=0.5|garden=5. Default: as fast as possible."
msgstr "Secondi tra le immagini, ad es. ingresso=0.5|giardino=5. Predefinito: il più veloce possibile."

msgctxt "#30066"
msgid "Remote control in photo window"
msgstr "Telecomando nella finestra foto"

msgctxt "#30067"
msgid "OK = live, LEFT/RIGHT = other camera, MENU = PTZ, BACK = close. Any other key closes it too."
msgstr "OK = live, SINISTRA/DESTRA = altra telecamera, MENU = PTZ, INDIETRO = chiudi. Ogni altro tasto chiude."

msgctxt "#30068"
msgid "Pause what is playing meanwhile"
msgstr "Metti in pausa la riproduzione"

msgctxt "#30069"
msgid "Pauses a video or live TV while the camera is shown and continues afterwards."
msgstr "Mette in pausa video o TV durante la visualizzazione, poi riprende."

msgctxt "#30070"
msgid "Return to what was playing"
msgstr "Torna a ciò che era in riproduzione"

msgctxt "#30071"
msgid "After live view, continue the video at the same position or the same TV channel."
msgstr "Dopo la visione live, riprende il video dallo stesso punto o lo stesso canale."

msgctxt "#30072"
msgid "Volume during live view (%)"
msgstr "Volume durante la visione live (%)"

msgctxt "#30073"
msgid "Percentage of the current volume while the camera is shown. 100 = unchanged."
msgstr "Percentuale del volume attuale mentre è visibile la telecamera. 100 = invariato."

msgctxt "#30074"
msgid "Live stream format"
msgstr "Formato della visione live"

msgctxt "#30075"
msgid "MP4 over HTTP works with every go2rtc set-up; RTSP needs go2rtc's RTSP port; HLS is the most robust but lags a few seconds."
msgstr "MP4 via HTTP funziona con ogni installazione di go2rtc; RTSP richiede la porta RTSP di go2rtc; HLS è il più robusto ma ha qualche secondo di ritardo."

msgctxt "#30076"
msgid "MP4 (HTTP)"
msgstr "MP4 (HTTP)"

msgctxt "#30077"
msgid "RTSP"
msgstr "RTSP"

msgctxt "#30078"
msgid "Tour: seconds per camera"
msgstr "Giro: secondi per telecamera"

msgctxt "#30079"
msgid "How long each camera is shown in the tour."
msgstr "Quanto resta ogni telecamera nel giro."

msgctxt "#30080"
msgid "HLS (HTTP, a few seconds delay)"
msgstr "HLS (HTTP, qualche secondo di ritardo)"

msgctxt "#30090"
msgid "Only between certain times"
msgstr "Solo in determinati orari"

msgctxt "#30091"
msgid "Ignore normal requests outside the chosen times. High and alarm always come through."
msgstr "Ignorare le richieste normali fuori dagli orari scelti. Alta e allarme passano sempre."

msgctxt "#30092"
msgid "From"
msgstr "Da"

msgctxt "#30093"
msgid "Until"
msgstr "Fino a"

msgctxt "#30094"
msgid "May pass midnight, e.g. 07:00 to 23:00."
msgstr "Può superare la mezzanotte, ad es. dalle 07:00 alle 23:00."

msgctxt "#30095"
msgid "Not while playing"
msgstr "Non durante la riproduzione"

msgctxt "#30096"
msgid "Normal-priority requests are ignored while you watch this. High and alarm always pass."
msgstr "Le richieste normali vengono ignorate durante la visione. Alta e allarme passano sempre."

msgctxt "#30097"
msgid "Always show"
msgstr "Mostra sempre"

msgctxt "#30098"
msgid "Not during movies and recordings"
msgstr "Non durante film e registrazioni"

msgctxt "#30099"
msgid "Not during anything (also live TV)"
msgstr "Mai durante la riproduzione (anche TV)"

msgctxt "#30100"
msgid "Wake up on alarm"
msgstr "Risveglio in caso di allarme"

msgctxt "#30101"
msgid "Requests with priority 'alarm' switch the TV on via HDMI-CEC."
msgstr "Le richieste 'alarm' accendono la TV tramite HDMI-CEC."

msgctxt "#30102"
msgid "Do not disturb"
msgstr "Non disturbare"

msgctxt "#30103"
msgid "Ignores requests with normal priority (with 'Do not disturb blocks' also high). Alarm always comes through. Also via the API, MQTT and Home Assistant."
msgstr "Ignora le richieste con priorità normale (con 'Non disturbare blocca' anche alta). L'allarme passa sempre. Anche tramite API, MQTT e Home Assistant."

msgctxt "#30104"
msgid "Do not disturb blocks"
msgstr "Non disturbare blocca"

msgctxt "#30105"
msgid "Which priorities are held back while do not disturb is on."
msgstr "Quali priorità vengono bloccate mentre è attivo Non disturbare."

msgctxt "#30106"
msgid "Normal priority"
msgstr "Priorità normale"

msgctxt "#30107"
msgid "Normal and high priority"
msgstr "Priorità normale e alta"

msgctxt "#30110"
msgid "MQTT (Home Assistant without YAML)"
msgstr "MQTT (Home Assistant senza YAML)"

msgctxt "#30111"
msgid "Connects to your MQTT broker; with discovery this Kodi appears in Home Assistant automatically."
msgstr "Si collega al broker MQTT; con il discovery questo Kodi compare in Home Assistant."

msgctxt "#30112"
msgid "MQTT broker address"
msgstr "Indirizzo broker MQTT"

msgctxt "#30113"
msgid "IP address or name of the MQTT broker, e.g. 192.168.1.10"
msgstr "Indirizzo IP o nome del broker MQTT, ad es. 192.168.1.10"

msgctxt "#30114"
msgid "MQTT port"
msgstr "Porta MQTT"

msgctxt "#30115"
msgid "Usually 1883."
msgstr "Di solito 1883."

msgctxt "#30116"
msgid "MQTT user"
msgstr "Utente MQTT"

msgctxt "#30117"
msgid "MQTT password"
msgstr "Password MQTT"

msgctxt "#30118"
msgid "Home Assistant discovery"
msgstr "Discovery di Home Assistant"

msgctxt "#30119"
msgid "Creates a device with a button per camera in Home Assistant."
msgstr "Crea in Home Assistant un dispositivo con un pulsante per telecamera."

msgctxt "#30120"
msgid "Name in Home Assistant"
msgstr "Nome in Home Assistant"

msgctxt "#30121"
msgid "Empty = CamAlert + the name of this Kodi."
msgstr "Vuoto = CamAlert + il nome di questo Kodi."

msgctxt "#30130"
msgid "Frigate events"
msgstr "Eventi Frigate"

msgctxt "#30131"
msgid "Shows the camera when Frigate detects something (via the MQTT broker)."
msgstr "Mostra la telecamera quando Frigate rileva qualcosa (via MQTT)."

msgctxt "#30132"
msgid "Frigate MQTT prefix"
msgstr "Prefisso MQTT di Frigate"

msgctxt "#30133"
msgid "Usually 'frigate'."
msgstr "Di solito 'frigate'."

msgctxt "#30134"
msgid "Objects"
msgstr "Oggetti"

msgctxt "#30135"
msgid "e.g. person,car. Empty = all."
msgstr "ad es. person,car. Vuoto = tutti."

msgctxt "#30136"
msgid "Frigate camera names"
msgstr "Nomi delle telecamere Frigate"

msgctxt "#30137"
msgid "Only if they differ: frigate_name=camera|..."
msgstr "Solo se diversi: nome_frigate=telecamera|..."

msgctxt "#30139"
msgid "Priority"
msgstr "Priorità"

msgctxt "#30140"
msgid "Normal"
msgstr "Normale"

msgctxt "#30141"
msgid "High"
msgstr "Alta"

msgctxt "#30142"
msgid "Alarm"
msgstr "Allarme"

msgctxt "#30143"
msgid "Foscam motion and sound alarms"
msgstr "Allarmi di movimento e audio Foscam"

msgctxt "#30144"
msgid "Asks the Foscam cameras in devices.conf for motion and sound alarms."
msgstr "Interroga le telecamere Foscam in devices.conf sugli allarmi."

msgctxt "#30145"
msgid "Check every (seconds)"
msgstr "Controlla ogni (secondi)"

msgctxt "#30150"
msgid "Cameras with PTZ or Foscam alarms"
msgstr "Telecamere con PTZ o allarme Foscam"

msgctxt "#30151"
msgid "Listed in devices.conf in the add-on data folder, one per line: name|onvif|address:80|user|password (or foscam, port 88)"
msgstr "Elencate in devices.conf nella cartella dati, una per riga: nome|onvif|indirizzo:80|utente|password (o foscam, porta 88)"

msgctxt "#30152"
msgid "Camera user (default)"
msgstr "Utente telecamera (predefinito)"

msgctxt "#30153"
msgid "Used when devices.conf has no user or password for a camera."
msgstr "Usato se devices.conf non indica utente o password."

msgctxt "#30154"
msgid "Camera password (default)"
msgstr "Password telecamera (predefinita)"

msgctxt "#30155"
msgid "Create devices.conf (example)"
msgstr "Crea devices.conf (esempio)"

msgctxt "#30160"
msgid "HTTP port"
msgstr "Porta HTTP"

msgctxt "#30161"
msgid "Port of the CamAlert API on this Kodi (default 8099)."
msgstr "Porta dell'API CamAlert su questo Kodi (predefinita 8099)."

msgctxt "#30162"
msgid "Allowed callers"
msgstr "Chiamanti consentiti"

msgctxt "#30163"
msgid "'Local network only' is recommended."
msgstr "Si consiglia 'Solo rete locale'."

msgctxt "#30164"
msgid "Local network only"
msgstr "Solo rete locale"

msgctxt "#30165"
msgid "Any address"
msgstr "Qualsiasi indirizzo"

msgctxt "#30166"
msgid "Access token (optional)"
msgstr "Token di accesso (facoltativo)"

msgctxt "#30167"
msgid "If set, callers must send it in the X-CamAlert-Token header; ?token=... in the address still works but is deprecated."
msgstr "Se impostato, chi chiama deve inviarlo nell'intestazione X-CamAlert-Token; ?token=... nell'indirizzo funziona ancora ma è deprecato."

msgctxt "#30168"
msgid "Use HTTPS for the API"
msgstr "Usare HTTPS per l'API"

msgctxt "#30169"
msgid "Uses a self-signed certificate; callers must turn off certificate checking."
msgstr "Usa un certificato autofirmato; i chiamanti devono disattivare la verifica."

msgctxt "#30170"
msgid "Test: show the default camera"
msgstr "Prova: mostra la telecamera predefinita"

msgctxt "#30171"
msgid "Show mosaic"
msgstr "Mostra mosaico"

msgctxt "#30172"
msgid "Start tour"
msgstr "Avvia giro"

msgctxt "#30180"
msgid "Camera: %s"
msgstr "Telecamera: %s"

msgctxt "#30181"
msgid "Could not reach the camera source:\n%s"
msgstr "Origine telecamere non raggiungibile:\n%s"

msgctxt "#30182"
msgid "No cameras found."
msgstr "Nessuna telecamera trovata."

msgctxt "#30184"
msgid "Choose a default camera first."
msgstr "Scegliere prima una telecamera predefinita."

msgctxt "#30185"
msgid "devices.conf is in:\n%s"
msgstr "devices.conf si trova in:\n%s"

msgctxt "#30190"
msgid "paused"
msgstr "in pausa"

msgctxt "#30191"
msgid "tour"
msgstr "giro"

msgctxt "#30192"
msgid "Cameras"
msgstr "Telecamere"

msgctxt "#30196"
msgid "No camera control set up for this camera (devices.conf)."
msgstr "Nessun controllo impostato per questa telecamera (devices.conf)."

msgctxt "#30200"
msgid "Checking..."
msgstr "Verifica in corso..."

msgctxt "#30201"
msgid "Diagnostics"
msgstr "Diagnostica"

msgctxt "#30202"
msgid "The CamAlert service is not running."
msgstr "Il servizio CamAlert non è attivo."

msgctxt "#30203"
msgid "No events yet."
msgstr "Ancora nessun evento."

msgctxt "#30204"
msgid "Event list"
msgstr "Elenco eventi"

msgctxt "#30205"
msgid "Show camera"
msgstr "Mostra telecamera"

msgctxt "#30206"
msgid "Play Frigate clip"
msgstr "Riproduci clip Frigate"

msgctxt "#30210"
msgid "go2rtc reachable (%d cameras, %d ms)"
msgstr "go2rtc raggiungibile (%d telecamere, %d ms)"

msgctxt "#30211"
msgid "go2rtc not reachable: %s"
msgstr "go2rtc non raggiungibile: %s"

msgctxt "#30212"
msgid "No valid go2rtc address"
msgstr "Nessun indirizzo go2rtc valido"

msgctxt "#30213"
msgid "%s: no snapshot address (live only)"
msgstr "%s: nessun indirizzo foto (solo live)"

msgctxt "#30214"
msgid "%s: snapshot %d ms"
msgstr "%s: foto %d ms"

msgctxt "#30215"
msgid "%s: snapshot failed (%s)"
msgstr "%s: foto non riuscita (%s)"

msgctxt "#30216"
msgid "API listening on port %d"
msgstr "API in ascolto sulla porta %d"

msgctxt "#30217"
msgid "API not listening on port %d"
msgstr "API non in ascolto sulla porta %d"

msgctxt "#30218"
msgid "MQTT connected"
msgstr "MQTT connesso"

msgctxt "#30219"
msgid "MQTT not connected"
msgstr "MQTT non connesso"

msgctxt "#30220"
msgid "Last API call %s from %s (%s)"
msgstr "Ultima chiamata API %s da %s (%s)"

msgctxt "#30221"
msgid "No API call since the last start"
msgstr "Nessuna chiamata API dall'ultimo avvio"

msgctxt "#30222"
msgid "Devices file: %s"
msgstr "File dispositivi: %s"

msgctxt "#30223"
msgid "Do not disturb is on"
msgstr "Non disturbare è attivo"

msgctxt "#30224"
msgid "Log: %s"
msgstr "Log: %s"

msgctxt "#30230"
msgid "Title size"
msgstr "Dimensione del titolo"

msgctxt "#30231"
msgid "Normal"
msgstr "Normale"

msgctxt "#30232"
msgid "Doorbell chime"
msgstr "Suono del campanello"

msgctxt "#30233"
msgid "Plays a chime when a camera appears (follows Kodi's volume)."
msgstr "Suona un campanello quando appare una telecamera (segue il volume di Kodi)."

msgctxt "#30234"
msgid "Off"
msgstr "Disattivato"

msgctxt "#30235"
msgid "Doorbell and alarm"
msgstr "Campanello e allarme"

msgctxt "#30236"
msgid "Every request"
msgstr "Ogni richiesta"

msgctxt "#30237"
msgid "Frigate address (for clips)"
msgstr "Indirizzo Frigate (per le clip)"

msgctxt "#30238"
msgid "e.g. http://192.168.1.10:5000 - lets you replay Frigate clips from the event list."
msgstr "ad es. http://192.168.1.10:5000 - per rivedere le clip Frigate dall'elenco eventi."

msgctxt "#30239"
msgid "Camera control (PTZ) key"
msgstr "Tasto per il controllo telecamera (PTZ)"

msgctxt "#30240"
msgid "On cameras with PTZ this key toggles camera control (MENU works too)."
msgstr "Sulle telecamere PTZ questo tasto attiva il controllo (anche MENU)."

msgctxt "#30241"
msgid "RED"
msgstr "ROSSO"

msgctxt "#30242"
msgid "GREEN"
msgstr "VERDE"

msgctxt "#30243"
msgid "YELLOW"
msgstr "GIALLO"

msgctxt "#30244"
msgid "BLUE"
msgstr "BLU"

msgctxt "#30245"
msgid "Colour keys to Home Assistant"
msgstr "Tasti colorati a Home Assistant"

msgctxt "#30246"
msgid "While a camera is shown the colour keys trigger a Home Assistant event (e.g. open the door)."
msgstr "Durante la visualizzazione i tasti colorati inviano un evento a Home Assistant (ad es. aprire la porta)."

msgctxt "#30247"
msgid "Log level"
msgstr "Livello di log"

msgctxt "#30248"
msgid "camalert.log in the add-on data folder (2 x 1 MB), besides kodi.log. Passwords are never logged."
msgstr "camalert.log nella cartella dati (2 x 1 MB), oltre a kodi.log. Le password non vengono mai registrate."

msgctxt "#30249"
msgid "Errors only"
msgstr "Solo errori"

msgctxt "#30250"
msgid "Verbose"
msgstr "Dettagliato"

msgctxt "#30251"
msgid "Remote syslog (host:port)"
msgstr "Syslog remoto (host:porta)"

msgctxt "#30252"
msgid "Optional, e.g. 192.168.1.10:514 (UDP). Empty = off."
msgstr "Facoltativo, ad es. 192.168.1.10:514 (UDP). Vuoto = disattivato."

msgctxt "#30253"
msgid "Home Assistant webhook"
msgstr "Webhook Home Assistant"

msgctxt "#30254"
msgid "%s - camera not reachable"
msgstr "%s - telecamera non raggiungibile"

msgctxt "#30255"
msgid "Cooldown per camera"
msgstr "Attesa per telecamera"

msgctxt "#30256"
msgid "Seconds per camera, e.g. *=30|garden=120 (* = all). An open window is still extended; alarm always passes."
msgstr "Secondi per telecamera, ad es. *=30|giardino=120 (* = tutte). Una finestra aperta viene prolungata; l'allarme passa sempre."

msgctxt "#30257"
msgid "Live view substreams"
msgstr "Substream per la visione live"

msgctxt "#30258"
msgid "For a camera this Kodi cannot play smoothly (H.265 / 4K): front_door=front_door_sub|... (go2rtc stream names)."
msgstr "Per una telecamera che questo Kodi non riproduce bene (H.265 / 4K): porta=porta_sub|... (nomi stream go2rtc)."

msgctxt "#30259"
msgid "Frigate objects"
msgstr "Oggetti Frigate"

msgctxt "#30260"
msgid "Frigate priority"
msgstr "Priorità Frigate"

msgctxt "#30261"
msgid "Foscam priority"
msgstr "Priorità Foscam"

msgctxt "#30262"
msgid "UniFi Protect events"
msgstr "Eventi UniFi Protect"

msgctxt "#30263"
msgid "Asks the UniFi Protect consoles in devices.conf for events (doorbell, person, vehicle, ...)."
msgstr "Interroga le console UniFi Protect in devices.conf sugli eventi (campanello, persona, veicolo, ...)."

msgctxt "#30264"
msgid "UniFi Protect event types"
msgstr "Tipi di eventi UniFi Protect"

msgctxt "#30265"
msgid "Comma separated: ring, person, vehicle, animal, package, motion."
msgstr "Separati da virgole: ring, person, vehicle, animal, package, motion."

msgctxt "#30266"
msgid "UniFi Protect camera names"
msgstr "Nomi delle telecamere UniFi Protect"

msgctxt "#30267"
msgid "Only if the names differ from go2rtc: protect=go2rtc|other=other_stream"
msgstr "Solo se i nomi differiscono da go2rtc: protect=go2rtc|other=other_stream"

msgctxt "#30268"
msgid "UniFi Protect priority"
msgstr "Priorità UniFi Protect"

msgctxt "#30269"
msgid "A doorbell ring always gets at least the priority High."
msgstr "Una suonata del campanello riceve sempre almeno la priorità Alta."

msgctxt "#30270"
msgid "Log only"
msgstr "Solo registro"

msgctxt "#30271"
msgid "Per event type"
msgstr "Per tipo di evento"

msgctxt "#30272"
msgid "Optional: type=priority/mode/camera, e.g. ring=alarm/live|motion=normal/log"
msgstr "Facoltativo: type=priority/mode/camera, ad es. ring=alarm/live|motion=normal/log"

msgctxt "#30273"
msgid "Per camera"
msgstr "Per telecamera"

msgctxt "#30274"
msgid "Optional, wins over the event type: camera=priority/mode/seconds, e.g. front_door=high/photo/30|driveway=normal/log"
msgstr "Facoltativo, prevale sul tipo di evento: camera=priority/mode/seconds, ad es. front_door=high/photo/30|driveway=normal/log"

msgctxt "#30275"
msgid "Change camera password (default)"
msgstr "Cambia password telecamera (predefinita)"

msgctxt "#30276"
msgid "Shows whether a default camera password is stored and lets you change or remove it. It is kept in devices.conf, not in the Kodi settings."
msgstr "Indica se è salvata una password predefinita per le telecamere e permette di cambiarla o rimuoverla. È conservata in devices.conf, non nelle impostazioni di Kodi."

msgctxt "#30277"
msgid "•••• (stored)"
msgstr "•••• (salvata)"

msgctxt "#30278"
