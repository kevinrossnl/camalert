msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de\n"

msgid "Photo window"
msgstr "Fotofenster"

msgid "Switch to live stream"
msgstr "Auf Live-Bild umschalten"

msgid "Notification only"
msgstr "Nur Hinweis"

msgid "Top right"
msgstr "Oben rechts"

msgid "Top left"
msgstr "Oben links"

msgid "Bottom right"
msgstr "Unten rechts"

msgid "Bottom left"
msgstr "Unten links"

msgid "Small"
msgstr "Klein"

msgid "Medium"
msgstr "Mittel"

msgid "Large"
msgstr "Groß"

msgid "Local network only"
msgstr "Nur lokales Netzwerk"

msgid "Any address"
msgstr "Jede Adresse"

msgid "Camera: %s"
msgstr "Kamera: %s"

msgid "Show IP cameras on your TV"
msgstr "IP-Kameras auf dem Fernseher anzeigen"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Save"
msgstr "Speichern"

msgid "Camera list"
msgstr "Kameraliste"

msgid "Test"
msgstr "Testen"

msgid "Enable CamAlert"
msgstr "CamAlert aktivieren"

msgid "Turn the HTTP API and pop-ups on or off."
msgstr "Schaltet die HTTP-API und die Einblendungen ein oder aus."

msgid "go2rtc address"
msgstr "go2rtc-Adresse"

msgid "Address of your go2rtc server, e.g. http://192.168.1.10:1984"
msgstr "Adresse Ihres go2rtc-Servers, z. B. http://192.168.1.10:1984"

msgid "go2rtc RTSP port"
msgstr "go2rtc-RTSP-Port"

msgid "Usually 8554. Used for live view and the camera list."
msgstr "Meist 8554. Für Live-Bild und Kameraliste."

msgid "Default camera"
msgstr "Standardkamera"

msgid "Press OK to choose from the cameras in go2rtc."
msgstr "OK drücken, um eine Kamera aus go2rtc zu wählen."

msgid "Display mode"
msgstr "Anzeige"

msgid "Photo window keeps watching TV; live switches the channel to the camera."
msgstr "Fotofenster: Fernsehen läuft weiter. Live: Kanal wechselt zur Kamera."

msgid "Duration (seconds)"
msgstr "Dauer (Sekunden)"

msgid "How long the camera stays on screen."
msgstr "Wie lange die Kamera angezeigt wird."

msgid "Window position"
msgstr "Fensterposition"

msgid "Window size"
msgstr "Fenstergröße"

msgid "Return to previous channel"
msgstr "Zurück zum vorherigen Kanal"

msgid "Switch back to what you were watching when the time is up."
msgstr "Nach Ablauf zurück zum vorherigen Programm."

msgid "HTTP port"
msgstr "HTTP-Port"

msgid "Port of the CamAlert API on this receiver (default 8099)."
msgstr "Port der CamAlert-API auf diesem Receiver (Standard 8099)."

msgid "Allowed callers"
msgstr "Erlaubte Aufrufer"

msgid "'Local network only' is recommended."
msgstr "'Nur lokales Netzwerk' wird empfohlen."

msgid "Access token (optional)"
msgstr "Zugriffstoken (optional)"

msgid "If set, callers must add ?token=... to every request."
msgstr "Wenn gesetzt, muss jede Anfrage ?token=... enthalten."

msgid "Camera list name"
msgstr "Name der Kameraliste"

msgid "Name of the channel list created with the yellow button."
msgstr "Name der Kanalliste, die die gelbe Taste erstellt."

msgid "Please enter a valid go2rtc address first."
msgstr "Bitte zuerst eine gültige go2rtc-Adresse eingeben."

msgid "Could not reach go2rtc:\n%s"
msgstr "go2rtc nicht erreichbar:\n%s"

msgid "go2rtc has no cameras configured."
msgstr "In go2rtc sind keine Kameras eingerichtet."

msgid "Choose camera"
msgstr "Kamera wählen"

msgid "Channel list '%s' with %d cameras created."
msgstr "Kanalliste '%s' mit %d Kameras erstellt."

msgid "Choose a default camera first."
msgstr "Bitte zuerst eine Standardkamera wählen."

msgid "Check go2rtc certificate"
msgstr "go2rtc-Zertifikat prüfen"

msgid "Turn off for a self-signed certificate (only in your own network)."
msgstr "Bei selbstsigniertem Zertifikat ausschalten (nur im eigenen Netzwerk)."

msgid "Pause TV meanwhile"
msgstr "Fernsehen währenddessen anhalten"

msgid "Pauses the channel (timeshift) while the camera is shown. Needs a hard disk or USB stick for timeshift."
msgstr "Hält den Kanal (Timeshift) an, solange die Kamera angezeigt wird. Benötigt Festplatte oder USB-Stick für Timeshift."

msgid "Use HTTPS for the API"
msgstr "HTTPS für die API verwenden"

msgid "Uses a self-signed certificate; callers must turn off certificate checking."
msgstr "Nutzt ein selbstsigniertes Zertifikat; Aufrufer müssen die Zertifikatsprüfung abschalten."

msgid "Volume during live view (%)"
msgstr "Lautstärke beim Live-Bild (%)"

msgid "Percentage of the current volume while the camera is shown. 100 = unchanged."
msgstr "Prozent der aktuellen Lautstärke, solange die Kamera angezeigt wird. 100 = unverändert."

msgid "Only between certain times"
msgstr "Nur zu bestimmten Zeiten"

msgid "Ignore requests outside the chosen times."
msgstr "Anfragen außerhalb der gewählten Zeiten ignorieren."

msgid "From"
msgstr "Von"

msgid "Until"
msgstr "Bis"

msgid "May pass midnight, e.g. 07:00 to 23:00."
msgstr "Darf über Mitternacht gehen, z. B. 07:00 bis 23:00."

msgid "Not during a recording"
msgstr "Nicht während einer Aufnahme"

msgid "Ignore requests while the receiver is recording."
msgstr "Anfragen ignorieren, während der Receiver aufnimmt."

msgid "Cameras"
msgstr "Kameras"

msgid "EXIT = close"
msgstr "EXIT = schließen"

msgid "CamAlert mosaic"
msgstr "CamAlert-Mosaik"

msgid "All cameras at once"
msgstr "Alle Kameras gleichzeitig"

msgid "Mosaic cameras"
msgstr "Kameras im Mosaik"

msgid "Press OK to choose up to 9 cameras for the mosaic. Empty = all."
msgstr "OK drücken, um bis zu 9 Kameras für das Mosaik zu wählen. Leer = alle."

msgid "Done"
msgstr "Fertig"

msgid "Start again"
msgstr "Neu beginnen"

msgid "go2rtc server"
msgstr "go2rtc-Server"

msgid "Directly from the cameras"
msgstr "Direkt von den Kameras"

msgid "Cameras via"
msgstr "Kameras über"

msgid "go2rtc is recommended. Without go2rtc, list your cameras in %s"
msgstr "go2rtc wird empfohlen. Ohne go2rtc tragen Sie Ihre Kameras in %s ein"

msgid "Check certificates"
msgstr "Zertifikate prüfen"

msgid "No cameras found in %s.\nSee the guide for the format."
msgstr "Keine Kameras in %s gefunden.\nDas Format steht in der Anleitung."

msgid "MQTT (Home Assistant without YAML)"
msgstr "MQTT (Home Assistant ohne YAML)"

msgid "Connects to your MQTT broker; with discovery the receiver appears in Home Assistant automatically."
msgstr "Verbindet sich mit Ihrem MQTT-Broker; mit Discovery erscheint der Receiver automatisch in Home Assistant."

msgid "MQTT broker address"
msgstr "Adresse des MQTT-Brokers"

msgid "IP address or name of the MQTT broker, e.g. 192.168.1.10"
msgstr "IP-Adresse oder Name des MQTT-Brokers, z. B. 192.168.1.10"

msgid "MQTT port"
msgstr "MQTT-Port"

msgid "Usually 1883."
msgstr "Meist 1883."

msgid "MQTT user"
msgstr "MQTT-Benutzer"

msgid "MQTT password"
msgstr "MQTT-Passwort"

msgid "Home Assistant discovery"
msgstr "Home-Assistant-Discovery"

msgid "Creates a device with a button per camera in Home Assistant."
msgstr "Legt in Home Assistant ein Gerät mit einer Taste pro Kamera an."

msgid "Name in Home Assistant"
msgstr "Name in Home Assistant"

msgid "Empty = CamAlert + the receiver's host name."
msgstr "Leer = CamAlert + Hostname des Receivers."

msgid "hold"
msgstr "angehalten"

msgid "tour"
msgstr "Rundgang"

msgid "GREEN = live"
msgstr "GRÜN = live"

msgid "CamAlert tour"
msgstr "CamAlert-Rundgang"

msgid "Cameras one after the other"
msgstr "Kameras nacheinander"

msgid "Remote control in photo window"
msgstr "Fernbedienung im Fotofenster"

msgid "OK = live, LEFT/RIGHT = other camera, EXIT = close. Any other key closes it too."
msgstr "OK = live, LINKS/RECHTS = andere Kamera, EXIT = schließen. Andere Tasten schließen ebenfalls."

msgid "Wake receiver on alarm"
msgstr "Receiver bei Alarm wecken"

msgid "Requests with priority 'alarm' switch the receiver (and TV via HDMI-CEC) on."
msgstr "Anfragen mit Priorität 'alarm' schalten den Receiver (und per HDMI-CEC den Fernseher) ein."

msgid "Tour: seconds per camera"
msgstr "Rundgang: Sekunden pro Kamera"

msgid "At the bottom"
msgstr "Unten"

msgid "At the top"
msgstr "Oben"

msgid "Camera names"
msgstr "Kameranamen"

msgid "Press OK to give a camera its own name (empty = automatic)."
msgstr "OK drücken, um einer Kamera einen eigenen Namen zu geben (leer = automatisch)."

msgid "Update camera list automatically"
msgstr "Kameraliste automatisch aktualisieren"

msgid "Checks every 30 minutes for new or removed cameras and updates the channel list."
msgstr "Prüft alle 30 Minuten auf neue oder entfernte Kameras und aktualisiert die Kanalliste."

msgid "Camera list position"
msgstr "Position der Kameraliste"

msgid "Where the camera list appears among your channel lists."
msgstr "Wo die Kameraliste zwischen Ihren Kanallisten erscheint."

msgid "Name for %s (empty = automatic)"
msgstr "Name für %s (leer = automatisch)"

msgid "%d own names"
msgstr "%d eigene Namen"

msgid "automatic"
msgstr "automatisch"

msgid "Where I put it"
msgstr "Wo ich sie hinlege"

