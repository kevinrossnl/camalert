msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr\n"

msgid "Photo window"
msgstr "Fenêtre photo"

msgid "Switch to live stream"
msgstr "Basculer vers le direct"

msgid "Notification only"
msgstr "Notification seulement"

msgid "Top right"
msgstr "En haut à droite"

msgid "Top left"
msgstr "En haut à gauche"

msgid "Bottom right"
msgstr "En bas à droite"

msgid "Bottom left"
msgstr "En bas à gauche"

msgid "Small"
msgstr "Petite"

msgid "Medium"
msgstr "Moyenne"

msgid "Large"
msgstr "Grande"

msgid "Local network only"
msgstr "Réseau local uniquement"

msgid "Any address"
msgstr "Toute adresse"

msgid "Camera: %s"
msgstr "Caméra : %s"

msgid "Show IP cameras on your TV"
msgstr "Afficher les caméras IP sur votre TV"

msgid "Cancel"
msgstr "Annuler"

msgid "Save"
msgstr "Enregistrer"

msgid "Camera list"
msgstr "Liste caméras"

msgid "Test"
msgstr "Tester"

msgid "Enable CamAlert"
msgstr "Activer CamAlert"

msgid "Turn the HTTP API and pop-ups on or off."
msgstr "Active ou désactive l'API HTTP et les fenêtres."

msgid "go2rtc address"
msgstr "Adresse go2rtc"

msgid "Address of your go2rtc server, e.g. http://192.168.1.10:1984"
msgstr "Adresse de votre serveur go2rtc, p. ex. http://192.168.1.10:1984"

msgid "go2rtc RTSP port"
msgstr "Port RTSP go2rtc"

msgid "Usually 8554. Used for live view and the camera list."
msgstr "Généralement 8554. Utilisé pour le direct et la liste des caméras."

msgid "Default camera"
msgstr "Caméra par défaut"

msgid "Press OK to choose from the cameras in go2rtc."
msgstr "Appuyez sur OK pour choisir parmi les caméras de go2rtc."

msgid "Display mode"
msgstr "Affichage"

msgid "Photo window keeps watching TV; live switches the channel to the camera."
msgstr "Fenêtre photo : la TV continue. Direct : la chaîne passe sur la caméra."

msgid "Duration (seconds)"
msgstr "Durée (secondes)"

msgid "How long the camera stays on screen."
msgstr "Durée d'affichage de la caméra."

msgid "Window position"
msgstr "Position de la fenêtre"

msgid "Window size"
msgstr "Taille de la fenêtre"

msgid "Return to previous channel"
msgstr "Revenir à la chaîne précédente"

msgid "Switch back to what you were watching when the time is up."
msgstr "Revenir à ce que vous regardiez une fois le temps écoulé."

msgid "HTTP port"
msgstr "Port HTTP"

msgid "Port of the CamAlert API on this receiver (default 8099)."
msgstr "Port de l'API CamAlert sur ce récepteur (8099 par défaut)."

msgid "Allowed callers"
msgstr "Appelants autorisés"

msgid "'Local network only' is recommended."
msgstr "« Réseau local uniquement » est recommandé."

msgid "Access token (optional)"
msgstr "Jeton d'accès (facultatif)"

msgid "If set, callers must add ?token=... to every request."
msgstr "Si défini, chaque requête doit contenir ?token=..."

msgid "Camera list name"
msgstr "Nom de la liste des caméras"

msgid "Name of the channel list created with the yellow button."
msgstr "Nom de la liste créée par la touche jaune."

msgid "Please enter a valid go2rtc address first."
msgstr "Veuillez d'abord saisir une adresse go2rtc valide."

msgid "Could not reach go2rtc:\n%s"
msgstr "Impossible de joindre go2rtc :\n%s"

msgid "go2rtc has no cameras configured."
msgstr "Aucune caméra configurée dans go2rtc."

msgid "Choose camera"
msgstr "Choisir la caméra"

msgid "Channel list '%s' with %d cameras created."
msgstr "Liste '%s' avec %d caméras créée."

msgid "Choose a default camera first."
msgstr "Choisissez d'abord une caméra par défaut."

msgid "Check go2rtc certificate"
msgstr "Vérifier le certificat go2rtc"

msgid "Turn off for a self-signed certificate (only in your own network)."
msgstr "Désactivez pour un certificat auto-signé (uniquement sur votre réseau)."

msgid "Pause TV meanwhile"
msgstr "Mettre la TV en pause"

msgid "Pauses the channel (timeshift) while the camera is shown. Needs a hard disk or USB stick for timeshift."
msgstr "Met la chaîne en pause (timeshift) pendant l'affichage de la caméra. Nécessite un disque ou une clé USB pour le timeshift."

msgid "Use HTTPS for the API"
msgstr "Utiliser HTTPS pour l'API"

msgid "Uses a self-signed certificate; callers must turn off certificate checking."
msgstr "Utilise un certificat auto-signé ; les appelants doivent désactiver la vérification."

msgid "Volume during live view (%)"
msgstr "Volume pendant le direct (%)"

msgid "Percentage of the current volume while the camera is shown. 100 = unchanged."
msgstr "Pourcentage du volume actuel pendant l'affichage de la caméra. 100 = inchangé."

msgid "Only between certain times"
msgstr "Seulement à certaines heures"

msgid "Ignore requests outside the chosen times."
msgstr "Ignorer les demandes en dehors des heures choisies."

msgid "From"
msgstr "De"

msgid "Until"
msgstr "Jusqu'à"

msgid "May pass midnight, e.g. 07:00 to 23:00."
msgstr "Peut passer minuit, p. ex. 07:00 à 23:00."

msgid "Not during a recording"
msgstr "Pas pendant un enregistrement"

msgid "Ignore requests while the receiver is recording."
msgstr "Ignorer les demandes pendant un enregistrement."

msgid "Cameras"
msgstr "Caméras"

msgid "EXIT = close"
msgstr "EXIT = fermer"

msgid "CamAlert mosaic"
msgstr "Mosaïque CamAlert"

msgid "All cameras at once"
msgstr "Toutes les caméras à la fois"

msgid "Mosaic cameras"
msgstr "Caméras de la mosaïque"

msgid "Press OK to choose up to 9 cameras for the mosaic. Empty = all."
msgstr "Appuyez sur OK pour choisir jusqu'à 9 caméras. Vide = toutes."

msgid "Done"
msgstr "Terminé"

msgid "Start again"
msgstr "Recommencer"

msgid "go2rtc server"
msgstr "Serveur go2rtc"

msgid "Directly from the cameras"
msgstr "Directement depuis les caméras"

msgid "Cameras via"
msgstr "Caméras via"

msgid "go2rtc is recommended. Without go2rtc, list your cameras in %s"
msgstr "go2rtc est recommandé. Sans go2rtc, listez vos caméras dans %s"

msgid "Check certificates"
msgstr "Vérifier les certificats"

msgid "No cameras found in %s.\nSee the guide for the format."
msgstr "Aucune caméra trouvée dans %s.\nVoir le guide pour le format."

msgid "MQTT (Home Assistant without YAML)"
msgstr "MQTT (Home Assistant sans YAML)"

msgid "Connects to your MQTT broker; with discovery the receiver appears in Home Assistant automatically."
msgstr "Se connecte à votre broker MQTT ; avec la découverte, le récepteur apparaît automatiquement dans Home Assistant."

msgid "MQTT broker address"
msgstr "Adresse du broker MQTT"

msgid "IP address or name of the MQTT broker, e.g. 192.168.1.10"
msgstr "Adresse IP ou nom du broker MQTT, p. ex. 192.168.1.10"

msgid "MQTT port"
msgstr "Port MQTT"

msgid "Usually 1883."
msgstr "Généralement 1883."

msgid "MQTT user"
msgstr "Utilisateur MQTT"

msgid "MQTT password"
msgstr "Mot de passe MQTT"

msgid "Home Assistant discovery"
msgstr "Découverte Home Assistant"

msgid "Creates a device with a button per camera in Home Assistant."
msgstr "Crée dans Home Assistant un appareil avec un bouton par caméra."

msgid "Name in Home Assistant"
msgstr "Nom dans Home Assistant"

msgid "Empty = CamAlert + the receiver's host name."
msgstr "Vide = CamAlert + nom d'hôte du récepteur."

msgid "hold"
msgstr "fixe"

msgid "tour"
msgstr "tournée"

msgid "GREEN = live"
msgstr "VERT = direct"

msgid "CamAlert tour"
msgstr "Tournée CamAlert"

msgid "Cameras one after the other"
msgstr "Caméras l'une après l'autre"

msgid "Remote control in photo window"
msgstr "Télécommande dans la fenêtre photo"

msgid "OK = live, LEFT/RIGHT = other camera, EXIT = close. Any other key closes it too."
msgstr "OK = direct, GAUCHE/DROITE = autre caméra, EXIT = fermer. Les autres touches ferment aussi."

msgid "Wake receiver on alarm"
msgstr "Réveiller le récepteur en cas d'alarme"

msgid "Requests with priority 'alarm' switch the receiver (and TV via HDMI-CEC) on."
msgstr "Les demandes de priorité 'alarm' allument le récepteur (et la TV via HDMI-CEC)."

msgid "Tour: seconds per camera"
msgstr "Tournée : secondes par caméra"

msgid "At the bottom"
msgstr "En bas"

msgid "At the top"
msgstr "En haut"

msgid "Camera names"
msgstr "Noms des caméras"

msgid "Press OK to give a camera its own name (empty = automatic)."
msgstr "Appuyez sur OK pour nommer une caméra (vide = automatique)."

msgid "Update camera list automatically"
msgstr "Mettre à jour la liste automatiquement"

msgid "Checks every 30 minutes for new or removed cameras and updates the channel list."
msgstr "Vérifie toutes les 30 minutes les caméras ajoutées ou supprimées et met à jour la liste."

msgid "Camera list position"
msgstr "Position de la liste"

msgid "Where the camera list appears among your channel lists."
msgstr "Où la liste apparaît parmi vos listes de chaînes."

msgid "Name for %s (empty = automatic)"
msgstr "Nom pour %s (vide = automatique)"

msgid "%d own names"
msgstr "%d noms personnalisés"

msgid "automatic"
msgstr "automatique"

msgid "Where I put it"
msgstr "Là où je la place"

msgid "Block normal requests (doorbell and alarm still come through)"
msgstr "Bloquer les demandes normales (sonnette et alarme passent)"

msgid "Block normal and doorbell requests (alarm still comes through)"
msgstr "Bloquer les demandes normales et de sonnette (l'alarme passe)"

msgid "Automatic"
msgstr "Automatique"

msgid "Below each other"
msgstr "Les unes sous les autres"

msgid "Next to each other"
msgstr "Côte à côte"

msgid "2 x 2"
msgstr "2 x 2"

msgid "Normal"
msgstr "Normale"

msgid "High (doorbell)"
msgstr "Haute (sonnette)"

msgid "Layout with several cameras"
msgstr "Disposition avec plusieurs caméras"

msgid "A request with 2-4 cameras shows them together in one corner window."
msgstr "Une demande avec 2 à 4 caméras les affiche ensemble dans une fenêtre d'angle."

msgid "%d cameras"
msgstr "%d caméras"

msgid "normal"
msgstr "normale"

msgid "as fast as possible"
msgstr "le plus vite possible"

msgid "Turn or mirror image"
msgstr "Tourner ou inverser l'image"

msgid "Press OK to turn a camera that hangs upside down (needs python3-pillow)."
msgstr "Appuyez sur OK pour tourner une caméra montée à l'envers (nécessite python3-pillow)."

msgid "Refresh interval"
msgstr "Intervalle d'actualisation"

msgid "Press OK to fetch a camera's photos less often (seconds), e.g. for a slow camera."
msgstr "Appuyez sur OK pour récupérer moins souvent les photos d'une caméra (secondes), p. ex. une caméra lente."

msgid "Do not disturb"
msgstr "Ne pas déranger"

msgid "Blocks requests with normal priority. Also via the API, MQTT and Home Assistant."
msgstr "Bloque les demandes de priorité normale. Aussi via l'API, MQTT et Home Assistant."

msgid "Do not disturb blocks"
msgstr "Ne pas déranger bloque"

msgid "Not while playing a recording or video"
msgstr "Pas pendant la lecture d'un enregistrement ou d'une vidéo"

msgid "Ignore normal requests while you watch a recording or a video file."
msgstr "Ignorer les demandes normales pendant que vous regardez un enregistrement ou une vidéo."

msgid "Frigate events"
msgstr "Événements Frigate"

msgid "Shows the camera when Frigate detects something (via MQTT, without Home Assistant)."
msgstr "Affiche la caméra quand Frigate détecte quelque chose (via MQTT, sans Home Assistant)."

msgid "Frigate MQTT prefix"
msgstr "Préfixe MQTT de Frigate"

msgid "Usually 'frigate'."
msgstr "Généralement 'frigate'."

msgid "Frigate objects"
msgstr "Objets Frigate"

msgid "Comma separated, e.g. person,car. Empty = all objects."
msgstr "Séparés par des virgules, p. ex. person,car. Vide = tous les objets."

msgid "Frigate camera names"
msgstr "Noms des caméras Frigate"

msgid "Only if the names differ from go2rtc: frigate=go2rtc|other=other_stream"
msgstr "Seulement si les noms diffèrent de go2rtc : frigate=go2rtc|other=other_stream"

msgid "Frigate priority"
msgstr "Priorité Frigate"

msgid "mirror (left/right)"
msgstr "miroir (gauche/droite)"

msgid "upside down (flip)"
msgstr "à l'envers (retourner)"

msgid "turned 180 degrees"
msgstr "tourné de 180 degrés"

msgid "every %s seconds"
msgstr "toutes les %s secondes"

msgid "Install python3-pillow to turn or mirror images:\nopkg install python3-pillow"
msgstr "Installez python3-pillow pour tourner ou inverser les images :\nopkg install python3-pillow"
