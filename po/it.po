msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: it\n"

msgid "Photo window"
msgstr "Finestra foto"

msgid "Switch to live stream"
msgstr "Passa al flusso live"

msgid "Notification only"
msgstr "Solo notifica"

msgid "Top right"
msgstr "In alto a destra"

msgid "Top left"
msgstr "In alto a sinistra"

msgid "Bottom right"
msgstr "In basso a destra"

msgid "Bottom left"
msgstr "In basso a sinistra"

msgid "Small"
msgstr "Piccola"

msgid "Medium"
msgstr "Media"

msgid "Large"
msgstr "Grande"

msgid "Local network only"
msgstr "Solo rete locale"

msgid "Any address"
msgstr "Qualsiasi indirizzo"

msgid "Camera: %s"
msgstr "Telecamera: %s"

msgid "Show IP cameras on your TV"
msgstr "Mostra le telecamere IP sulla TV"

msgid "Cancel"
msgstr "Annulla"

msgid "Save"
msgstr "Salva"

msgid "Camera list"
msgstr "Elenco telecamere"

msgid "Test"
msgstr "Prova"

msgid "Enable CamAlert"
msgstr "Attiva CamAlert"

msgid "Turn the HTTP API and pop-ups on or off."
msgstr "Attiva o disattiva l'API HTTP e le finestre."

msgid "go2rtc address"
msgstr "Indirizzo go2rtc"

msgid "Address of your go2rtc server, e.g. http://192.168.1.10:1984"
msgstr "Indirizzo del server go2rtc, ad es. http://192.168.1.10:1984"

msgid "go2rtc RTSP port"
msgstr "Porta RTSP go2rtc"

msgid "Usually 8554. Used for live view and the camera list."
msgstr "Di solito 8554. Usata per il live e l'elenco telecamere."

msgid "Default camera"
msgstr "Telecamera predefinita"

msgid "Press OK to choose from the cameras in go2rtc."
msgstr "Premi OK per scegliere tra le telecamere di go2rtc."

msgid "Display mode"
msgstr "Visualizzazione"

msgid "Photo window keeps watching TV; live switches the channel to the camera."
msgstr "Finestra foto: la TV continua. Live: il canale passa alla telecamera."

msgid "Duration (seconds)"
msgstr "Durata (secondi)"

msgid "How long the camera stays on screen."
msgstr "Per quanto tempo resta visibile la telecamera."

msgid "Window position"
msgstr "Posizione finestra"

msgid "Window size"
msgstr "Dimensione finestra"

msgid "Return to previous channel"
msgstr "Torna al canale precedente"

msgid "Switch back to what you were watching when the time is up."
msgstr "Torna a ciò che stavi guardando allo scadere del tempo."

msgid "HTTP port"
msgstr "Porta HTTP"

msgid "Port of the CamAlert API on this receiver (default 8099)."
msgstr "Porta dell'API CamAlert su questo ricevitore (predefinita 8099)."

msgid "Allowed callers"
msgstr "Chiamanti consentiti"

msgid "'Local network only' is recommended."
msgstr "Si consiglia 'Solo rete locale'."

msgid "Access token (optional)"
msgstr "Token di accesso (facoltativo)"

msgid "If set, callers must add ?token=... to every request."
msgstr "Se impostato, ogni richiesta deve contenere ?token=..."

msgid "Camera list name"
msgstr "Nome elenco telecamere"

msgid "Name of the channel list created with the yellow button."
msgstr "Nome dell'elenco creato con il tasto giallo."

msgid "Please enter a valid go2rtc address first."
msgstr "Inserisci prima un indirizzo go2rtc valido."

msgid "Could not reach go2rtc:\n%s"
msgstr "Impossibile raggiungere go2rtc:\n%s"

msgid "go2rtc has no cameras configured."
msgstr "Nessuna telecamera configurata in go2rtc."

msgid "Choose camera"
msgstr "Scegli telecamera"

msgid "Channel list '%s' with %d cameras created."
msgstr "Elenco '%s' con %d telecamere creato."

msgid "Choose a default camera first."
msgstr "Scegli prima una telecamera predefinita."

msgid "Check go2rtc certificate"
msgstr "Verifica certificato go2rtc"

msgid "Turn off for a self-signed certificate (only in your own network)."
msgstr "Disattiva per un certificato autofirmato (solo nella tua rete)."

msgid "Pause TV meanwhile"
msgstr "Metti in pausa la TV"

msgid "Pauses the channel (timeshift) while the camera is shown. Needs a hard disk or USB stick for timeshift."
msgstr "Mette in pausa il canale (timeshift) mentre è visibile la telecamera. Serve un disco o una chiavetta USB per il timeshift."

msgid "Use HTTPS for the API"
msgstr "Usa HTTPS per l'API"

msgid "Uses a self-signed certificate; callers must turn off certificate checking."
msgstr "Usa un certificato autofirmato; i chiamanti devono disattivare la verifica."

msgid "Volume during live view (%)"
msgstr "Volume durante il live (%)"

msgid "Percentage of the current volume while the camera is shown. 100 = unchanged."
msgstr "Percentuale del volume attuale mentre è visibile la telecamera. 100 = invariato."

msgid "Only between certain times"
msgstr "Solo in determinati orari"

msgid "Ignore requests outside the chosen times."
msgstr "Ignora le richieste fuori dagli orari scelti."

msgid "From"
msgstr "Da"

msgid "Until"
msgstr "Fino a"

msgid "May pass midnight, e.g. 07:00 to 23:00."
msgstr "Può superare la mezzanotte, ad es. dalle 07:00 alle 23:00."

msgid "Not during a recording"
msgstr "Non durante una registrazione"

msgid "Ignore requests while the receiver is recording."
msgstr "Ignora le richieste mentre il ricevitore registra."

msgid "Cameras"
msgstr "Telecamere"

msgid "EXIT = close"
msgstr "EXIT = chiudi"

msgid "CamAlert mosaic"
msgstr "Mosaico CamAlert"

msgid "All cameras at once"
msgstr "Tutte le telecamere insieme"

msgid "Mosaic cameras"
msgstr "Telecamere del mosaico"

msgid "Press OK to choose up to 9 cameras for the mosaic. Empty = all."
msgstr "Premi OK per scegliere fino a 9 telecamere. Vuoto = tutte."

msgid "Done"
msgstr "Fatto"

msgid "Start again"
msgstr "Ricomincia"

msgid "go2rtc server"
msgstr "Server go2rtc"

msgid "Directly from the cameras"
msgstr "Direttamente dalle telecamere"

msgid "Cameras via"
msgstr "Telecamere tramite"

msgid "go2rtc is recommended. Without go2rtc, list your cameras in %s"
msgstr "Si consiglia go2rtc. Senza go2rtc, elenca le telecamere in %s"

msgid "Check certificates"
msgstr "Verifica certificati"

msgid "No cameras found in %s.\nSee the guide for the format."
msgstr "Nessuna telecamera trovata in %s.\nVedi la guida per il formato."

msgid "MQTT (Home Assistant without YAML)"
msgstr "MQTT (Home Assistant senza YAML)"

msgid "Connects to your MQTT broker; with discovery the receiver appears in Home Assistant automatically."
msgstr "Si collega al broker MQTT; con il discovery il ricevitore compare da solo in Home Assistant."

msgid "MQTT broker address"
msgstr "Indirizzo broker MQTT"

msgid "IP address or name of the MQTT broker, e.g. 192.168.1.10"
msgstr "Indirizzo IP o nome del broker MQTT, ad es. 192.168.1.10"

msgid "MQTT port"
msgstr "Porta MQTT"

msgid "Usually 1883."
msgstr "Di solito 1883."

msgid "MQTT user"
msgstr "Utente MQTT"

msgid "MQTT password"
msgstr "Password MQTT"

msgid "Home Assistant discovery"
msgstr "Discovery di Home Assistant"

msgid "Creates a device with a button per camera in Home Assistant."
msgstr "Crea in Home Assistant un dispositivo con un pulsante per telecamera."

msgid "Name in Home Assistant"
msgstr "Nome in Home Assistant"

msgid "Empty = CamAlert + the receiver's host name."
msgstr "Vuoto = CamAlert + nome host del ricevitore."

msgid "hold"
msgstr "fermo"

msgid "tour"
msgstr "giro"

msgid "GREEN = live"
msgstr "VERDE = live"

msgid "CamAlert tour"
msgstr "Giro CamAlert"

msgid "Cameras one after the other"
msgstr "Telecamere una dopo l'altra"

msgid "Remote control in photo window"
msgstr "Telecomando nella finestra foto"

msgid "OK = live, LEFT/RIGHT = other camera, EXIT = close. Any other key closes it too."
msgstr "OK = live, SINISTRA/DESTRA = altra telecamera, EXIT = chiudi. Anche gli altri tasti chiudono."

msgid "Wake receiver on alarm"
msgstr "Risveglia il ricevitore in caso di allarme"

msgid "Requests with priority 'alarm' switch the receiver (and TV via HDMI-CEC) on."
msgstr "Le richieste con priorità 'alarm' accendono il ricevitore (e la TV tramite HDMI-CEC)."

msgid "Tour: seconds per camera"
msgstr "Giro: secondi per telecamera"

msgid "At the bottom"
msgstr "In fondo"

msgid "At the top"
msgstr "In cima"

msgid "Camera names"
msgstr "Nomi telecamere"

msgid "Press OK to give a camera its own name (empty = automatic)."
msgstr "Premi OK per dare un nome a una telecamera (vuoto = automatico)."

msgid "Update camera list automatically"
msgstr "Aggiorna l'elenco automaticamente"

msgid "Checks every 30 minutes for new or removed cameras and updates the channel list."
msgstr "Controlla ogni 30 minuti telecamere nuove o rimosse e aggiorna l'elenco."

msgid "Camera list position"
msgstr "Posizione dell'elenco"

msgid "Where the camera list appears among your channel lists."
msgstr "Dove appare l'elenco tra le tue liste di canali."

msgid "Name for %s (empty = automatic)"
msgstr "Nome per %s (vuoto = automatico)"

msgid "%d own names"
msgstr "%d nomi personalizzati"

msgid "automatic"
msgstr "automatico"

msgid "Where I put it"
msgstr "Dove la metto io"

msgid "Block normal requests (doorbell and alarm still come through)"
msgstr "Blocca le richieste normali (campanello e allarme passano)"

msgid "Block normal and doorbell requests (alarm still comes through)"
msgstr "Blocca richieste normali e del campanello (l'allarme passa)"

msgid "Automatic"
msgstr "Automatico"

msgid "Below each other"
msgstr "Una sotto l'altra"

msgid "Next to each other"
msgstr "Una accanto all'altra"

msgid "2 x 2"
msgstr "2 x 2"

msgid "Normal"
msgstr "Normale"

msgid "High (doorbell)"
msgstr "Alta (campanello)"

msgid "Layout with several cameras"
msgstr "Disposizione con più telecamere"

msgid "A request with 2-4 cameras shows them together in one corner window."
msgstr "Una richiesta con 2-4 telecamere le mostra insieme in una finestra d'angolo."

msgid "%d cameras"
msgstr "%d telecamere"

msgid "normal"
msgstr "normale"

msgid "as fast as possible"
msgstr "il più veloce possibile"

msgid "Turn or mirror image"
msgstr "Ruota o specchia l'immagine"

msgid "Press OK to turn a camera that hangs upside down (needs python3-pillow)."
msgstr "Premi OK per ruotare una telecamera montata capovolta (richiede python3-pillow)."

msgid "Refresh interval"
msgstr "Intervallo di aggiornamento"

msgid "Press OK to fetch a camera's photos less often (seconds), e.g. for a slow camera."
msgstr "Premi OK per scaricare meno spesso le foto di una telecamera (secondi), ad es. per una telecamera lenta."

msgid "Do not disturb"
msgstr "Non disturbare"

msgid "Blocks requests with normal priority. Also via the API, MQTT and Home Assistant."
msgstr "Blocca le richieste con priorità normale. Anche tramite API, MQTT e Home Assistant."

msgid "Do not disturb blocks"
msgstr "Non disturbare blocca"

msgid "Not while playing a recording or video"
msgstr "Non durante la riproduzione di una registrazione o di un video"

msgid "Ignore normal requests while you watch a recording or a video file."
msgstr "Ignora le richieste normali mentre guardi una registrazione o un file video."

msgid "Frigate events"
msgstr "Eventi Frigate"

msgid "Shows the camera when Frigate detects something (via MQTT, without Home Assistant)."
msgstr "Mostra la telecamera quando Frigate rileva qualcosa (via MQTT, senza Home Assistant)."

msgid "Frigate MQTT prefix"
msgstr "Prefisso MQTT di Frigate"

msgid "Usually 'frigate'."
msgstr "Di solito 'frigate'."

msgid "Frigate objects"
msgstr "Oggetti Frigate"

msgid "Comma separated, e.g. person,car. Empty = all objects."
msgstr "Separati da virgole, ad es. person,car. Vuoto = tutti gli oggetti."

msgid "Frigate camera names"
msgstr "Nomi delle telecamere Frigate"

msgid "Only if the names differ from go2rtc: frigate=go2rtc|other=other_stream"
msgstr "Solo se i nomi differiscono da go2rtc: frigate=go2rtc|other=other_stream"

msgid "Frigate priority"
msgstr "Priorità Frigate"

msgid "mirror (left/right)"
msgstr "specchia (sinistra/destra)"

msgid "upside down (flip)"
msgstr "capovolto"

msgid "turned 180 degrees"
msgstr "ruotato di 180 gradi"

msgid "every %s seconds"
msgstr "ogni %s secondi"

msgid "Install python3-pillow to turn or mirror images:\nopkg install python3-pillow"
msgstr "Installa python3-pillow per ruotare o specchiare le immagini:\nopkg install python3-pillow"

msgid "Off"
msgstr "Disattivato"

msgid "Errors only"
msgstr "Solo errori"

msgid "Verbose"
msgstr "Dettagliato"

msgid "BLUE"
msgstr "BLU"

msgid "YELLOW"
msgstr "GIALLO"

msgid "RED"
msgstr "ROSSO"

msgid "GREEN"
msgstr "VERDE"

msgid "go2rtc reachable (%d cameras, %d ms)"
msgstr "go2rtc raggiungibile (%d telecamere, %d ms)"

msgid "go2rtc not reachable: %s"
msgstr "go2rtc non raggiungibile: %s"

msgid "No valid go2rtc address"
msgstr "Nessun indirizzo go2rtc valido"

msgid "%s: no snapshot address (live only)"
msgstr "%s: nessun indirizzo foto (solo live)"

msgid "%s: snapshot %d ms"
msgstr "%s: foto %d ms"

msgid "%s: snapshot failed (%s)"
msgstr "%s: foto non riuscita (%s)"

msgid "API listening on port %d"
msgstr "API in ascolto sulla porta %d"

msgid "API not listening on port %d"
msgstr "API non in ascolto sulla porta %d"

msgid "MQTT connected"
msgstr "MQTT connesso"

msgid "MQTT not connected"
msgstr "MQTT non connesso"

msgid "Last API call %s from %s (%s)"
msgstr "Ultima chiamata API %s da %s (%s)"

msgid "No API call since the last start"
msgstr "Nessuna chiamata API dall'ultimo avvio"

msgid "Devices file: %s"
msgstr "File dispositivi: %s"

msgid "Do not disturb is on"
msgstr "Non disturbare è attivo"

msgid "Log: %s"
msgstr "Log: %s"

msgid "off"
msgstr "disattivato"

msgid "CamAlert diagnostics"
msgstr "Diagnostica CamAlert"

msgid "Checking..."
msgstr "Verifica in corso..."

msgid "Close"
msgstr "Chiudi"

msgid "Check again"
msgstr "Verifica di nuovo"

msgid "Last log lines:"
msgstr "Ultime righe del log:"

msgid "CamAlert events"
msgstr "Eventi CamAlert"

msgid "No events yet"
msgstr "Ancora nessun evento"

msgid "Play clip"
msgstr "Riproduci clip"

msgid "Source"
msgstr "Origine"

msgid "Priority"
msgstr "Priorità"

msgid "Result"
msgstr "Risultato"

msgid "Motion"
msgstr "Movimento"

msgid "PTZ %s: arrows = move, CH+/CH- = zoom, OK = home, EXIT = done"
msgstr "PTZ %s: frecce = muovi, CH+/CH- = zoom, OK = posizione iniziale, EXIT = fine"

msgid "The last camera requests"
msgstr "Le ultime richieste delle telecamere"

msgid "MENU = diagnostics / events"
msgstr "MENU = diagnostica / eventi"

msgid "Title size"
msgstr "Dimensione del titolo"

msgid "Frigate address (for clips)"
msgstr "Indirizzo Frigate (per le clip)"

msgid "Optional, e.g. http://192.168.1.10:5000 - lets you play the clip of an event from the event list."
msgstr "Facoltativo, ad es. http://192.168.1.10:5000 - permette di riprodurre la clip di un evento dall'elenco eventi."

msgid "Colour keys to Home Assistant"
msgstr "Tasti colorati a Home Assistant"

msgid "While a camera is on screen the colour keys send an event to Home Assistant (e.g. open the gate)."
msgstr "Mentre è mostrata una telecamera, i tasti colorati inviano un evento a Home Assistant (ad es. aprire il cancello)."

msgid "PTZ key"
msgstr "Tasto PTZ"

msgid "For cameras with PTZ in %s: this key switches PTZ mode on (arrows, CH+/CH-, OK = home)."
msgstr "Per le telecamere PTZ in %s: questo tasto attiva la modalità PTZ (frecce, CH+/CH-, OK = posizione iniziale)."

msgid "Foscam motion alarms"
msgstr "Allarmi di movimento Foscam"

msgid "Asks Foscam cameras from %s every 2 seconds for a motion or sound alarm."
msgstr "Chiede ogni 2 secondi alle telecamere Foscam in %s se c'è un allarme di movimento o audio."

msgid "Foscam priority"
msgstr "Priorità Foscam"

msgid "Event snapshots folder"
msgstr "Cartella foto degli eventi"

msgid "Small photos of the last 20 events (default /tmp/camalert_events)."
msgstr "Piccole foto degli ultimi 20 eventi (predefinito /tmp/camalert_events)."

msgid "Log level"
msgstr "Livello di log"

msgid "camalert.log in /home/root/logs (or /tmp). Passwords and tokens are never logged."
msgstr "camalert.log in /home/root/logs (o /tmp). Password e token non vengono mai registrati."

msgid "Remote syslog (host:port)"
msgstr "Syslog remoto (host:porta)"

msgid "Optional: also send the log via UDP (RFC 5424), e.g. to Loki/Alloy."
msgstr "Facoltativo: invia il log anche via UDP (RFC 5424), ad es. a Loki/Alloy."

msgid "Check for updates"
msgstr "Cerca aggiornamenti"

msgid "Looks once a day on GitHub for a new version and shows a message."
msgstr "Cerca una volta al giorno su GitHub una nuova versione e mostra un messaggio."

msgid "Diagnostics"
msgstr "Diagnostica"

msgid "Event list"
msgstr "Elenco eventi"

msgid "CamAlert %s is available (installed: %s).\nUpdate via the software update or: opkg update && opkg upgrade"
msgstr "CamAlert %s è disponibile (installato: %s).\nAggiorna tramite l'aggiornamento software o: opkg update && opkg upgrade"
